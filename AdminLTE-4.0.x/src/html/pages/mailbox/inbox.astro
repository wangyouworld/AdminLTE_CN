---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | 邮箱"
const path = "../../../dist"
const htmlPath = ".."
const mainPage = "mailbox"
const page = "inbox";

const messages = [
  { from: "奥利维亚·贝内特", subject: "回复：设计系统 v2.4 签收", preview: "已批准——关于表单成功状态的一些小备注。", time: "上午 10:42", unread: true, starred: true, label: "primary" },
  { from: "GitHub", subject: "[fullcalendar/fullcalendar] PR #6912 已合并", preview: "允许为时间网格轴标签自定义渲染钩子。", time: "上午 9:08", unread: true, starred: false, label: "secondary" },
  { from: "Stripe", subject: "您的五月发票已就绪", preview: "发票 INV-2026-00428 总计 108.31 美元已开具。", time: "上午 8:15", unread: true, starred: false, label: "success" },
  { from: "Marcus Reyes", subject: "周四一起吃午饭？", preview: "下午 1 点左右在老地方。有空告诉我一声。", time: "昨天", unread: false, starred: true, label: "info" },
  { from: "Linear", subject: "[ADM-441] 日历拖拽功能在 Safari iOS 上无法使用", preview: "在 iOS 18.4 上的 Safari 和 Chrome 中可稳定复现。", time: "昨天", unread: false, starred: false, label: "warning" },
  { from: "Vercel", subject: "部署成功——生产环境", preview: "main@a3c91fb 在 47 秒内部署到生产环境。", time: "5 月 16 日", unread: false, starred: false, label: "success" },
  { from: "Sara Khan", subject: "客户访谈记录——Acme 公司", preview: "三大主题：新手问题、账单可见性、移动端。", time: "5 月 15 日", unread: false, starred: false, label: "primary" },
  { from: "AWS", subject: "您的月度账单摘要", preview: "2026 年 4 月总费用：312.94 美元。请在控制台中查看。", time: "5 月 14 日", unread: false, starred: false, label: "danger" }
];
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head title={title} path={path} />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">邮箱</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">首页</a></li>
                    <li class="breadcrumb-item active" aria-current="page">收件箱</li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="row g-3">
              <!-- Folder sidebar -->
              <div class="col-lg-3">
                <a
                  href={htmlPath + "/mailbox/compose.html"}
                  class="btn btn-primary w-100 mb-3"
                >
                  <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>
                  写信
                </a>
                <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">文件夹</h3>
                  </div>
                  <div class="card-body p-0">
                    <ul class="nav nav-pills flex-column mb-0">
                      <li class="nav-item">
                        <a
                          href={htmlPath + "/mailbox/inbox.html"}
                          class="nav-link active rounded-0 d-flex justify-content-between"
                        >
                          <span>
                            <i class="bi bi-inbox me-2" aria-hidden="true"></i>收件箱
                          </span>
                          <span class="badge text-bg-primary">3</span>
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link rounded-0">
                          <i class="bi bi-send me-2" aria-hidden="true"></i>已发送
                        </a>
                      </li>
                      <li class="nav-item">
                        <a
                          href="#"
                          class="nav-link rounded-0 d-flex justify-content-between"
                        >
                          <span>
                            <i class="bi bi-file-earmark me-2" aria-hidden="true"></i>
                            草稿
                          </span>
                          <span class="badge text-bg-secondary">2</span>
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link rounded-0">
                          <i class="bi bi-star me-2" aria-hidden="true"></i>标星
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link rounded-0">
                          <i class="bi bi-archive me-2" aria-hidden="true"></i>归档
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link rounded-0">
                          <i
                            class="bi bi-exclamation-octagon me-2"
                            aria-hidden="true"
                          ></i>
                          垃圾邮件
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link rounded-0">
                          <i class="bi bi-trash me-2" aria-hidden="true"></i>回收站
                        </a>
                      </li>
                    </ul>
                  </div>
                </div>
                <div class="card mt-3">
                  <div class="card-header">
                    <h3 class="card-title">标签</h3>
                  </div>
                  <div class="card-body p-0">
                    <ul class="nav flex-column mb-0">
                      <li class="nav-item">
                        <a href="#" class="nav-link">
                          <i
                            class="bi bi-circle-fill text-primary me-2"
                            style="font-size: 0.6rem;"
                            aria-hidden="true"
                          ></i>
                          客户
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link">
                          <i
                            class="bi bi-circle-fill text-success me-2"
                            style="font-size: 0.6rem;"
                            aria-hidden="true"
                          ></i>
                          广告
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link">
                          <i
                            class="bi bi-circle-fill text-warning me-2"
                            style="font-size: 0.6rem;"
                            aria-hidden="true"
                          ></i>
                          内部
                        </a>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Inbox list -->
              <div class="col-lg-9">
                <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">收件箱</h3>
                    <div class="card-tools">
                      <div class="input-group input-group-sm" style="width: 16rem;">
                        <span class="input-group-text">
                          <i class="bi bi-search" aria-hidden="true"></i>
                        </span>
                        <input
                          type="search"
                          class="form-control"
                          placeholder="搜索邮件&hellip;"
                          aria-label="搜索邮件"
                        />
                      </div>
                    </div>
                  </div>
                  <div class="card-body p-0">
                    <div
                      class="d-flex align-items-center px-3 py-2 border-bottom"
                    >
                      <div class="form-check mb-0">
                        <input
                          class="form-check-input"
                          type="checkbox"
                          id="select-all"
                        />
                        <label class="form-check-label visually-hidden" for="select-all">
                          全选
                        </label>
                      </div>
                      <div class="btn-group btn-group-sm ms-3">
                        <button
                          class="btn btn-outline-secondary"
                          type="button"
                          title="Refresh"
                        >
                          <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                        </button>
                        <button
                          class="btn btn-outline-secondary"
                          type="button"
                          title="存档"
                        >
                          <i class="bi bi-archive" aria-hidden="true"></i>
                        </button>
                        <button
                          class="btn btn-outline-secondary"
                          type="button"
                          title="Mark as spam"
                        >
                          <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
                        </button>
                        <button
                          class="btn btn-outline-secondary"
                          type="button"
                          title="删除"
                        >
                          <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                      </div>
                      <span class="ms-auto text-secondary small">
                        1&ndash;{messages.length} of {messages.length}
                      </span>
                    </div>
                    <ul class="list-group list-group-flush mb-0">
                      {
                        messages.map((m, idx) => (
                          <li
                            class:list={[
                              "list-group-item d-flex align-items-center gap-2",
                              m.unread && "fw-semibold bg-body-secondary"
                            ]}
                          >
                            <div class="form-check mb-0">
                              <input
                                class="form-check-input"
                                type="checkbox"
                                id={`msg-${idx}`}
                              />
                              <label
                                class="form-check-label visually-hidden"
                                for={`msg-${idx}`}
                              >
                                选择邮件来自 {m.from}
                              </label>
                            </div>
                            <button
                              class="btn btn-link p-0 text-warning lh-1"
                              type="button"
                              title={m.starred ? "标星" : "Star"}
                              aria-label={m.starred ? "标星" : "Star"}
                            >
                              <i
                                class={
                                  m.starred ? "bi bi-star-fill" : "bi bi-star"
                                }
                                aria-hidden="true"
                              />
                            </button>
                            <a
                              href={htmlPath + "/mailbox/read.html"}
                              class="flex-grow-1 d-flex flex-column flex-md-row gap-md-3 text-decoration-none text-body"
                              style="min-width: 0;"
                            >
                              <span class="text-truncate" style="min-width: 9rem;">
                                {m.from}
                              </span>
                              <span class="flex-grow-1 text-truncate" style="min-width: 0;">
                                <span class={`badge text-bg-${m.label} me-2`}>
                                  &middot;
                                </span>
                                {m.subject}
                                <span class="fw-normal text-secondary">
                                  &nbsp;&mdash; {m.preview}
                                </span>
                              </span>
                              <span class="text-secondary small text-md-end" style="min-width: 5rem;">
                                {m.time}
                              </span>
                            </a>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
  </body>
</html>

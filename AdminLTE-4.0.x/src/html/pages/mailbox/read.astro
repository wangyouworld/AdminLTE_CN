---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | 邮箱 - 查看邮件"
const path = "../../../dist"
const htmlPath = ".."
const mainPage = "mailbox"
const page = "read";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head title={title} path={path} />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h3 class="mb-0">查看邮件</h3>
              </div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                  <li class="breadcrumb-item"><a href="#">首页</a></li>
                  <li class="breadcrumb-item">
                    <a href={htmlPath + "/mailbox/inbox.html"}>邮箱</a>
                  </li>
                  <li class="breadcrumb-item active" aria-current="page">查看</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="card">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title">Re: design system v2.4 sign-off</h3>
                <div class="btn-group btn-group-sm">
                  <a
                    href={htmlPath + "/mailbox/inbox.html"}
                    class="btn btn-outline-secondary"
                    title="Back to inbox"
                  >
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                  </a>
                  <button
                    class="btn btn-outline-secondary"
                    type="button"
                    title="上一页"
                  >
                    <i class="bi bi-chevron-up" aria-hidden="true"></i>
                  </button>
                  <button
                    class="btn btn-outline-secondary"
                    type="button"
                    title="下一页"
                  >
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                  </button>
                </div>
              </div>
              <div class="card-body">
                <!-- Sender meta -->
                <div class="d-flex gap-3 align-items-start mb-4">
                  <div
                    class="flex-shrink-0 rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                    style="width: 48px; height: 48px;"
                    aria-hidden="true"
                  >
                    OB
                  </div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between">
                      <div>
                        <p class="mb-0 fw-semibold">奥利维亚·贝内特</p>
                        <small class="text-secondary">
                          olivia@example.com &mdash; 发给我
                        </small>
                      </div>
                      <small class="text-secondary">上午 10:42 &middot; 2 小时前</small>
                    </div>
                  </div>
                </div>

                <!-- Body -->
                <div class="mb-4">
                  <p>嗨，简，</p>
                  <p>
                    今天上午审阅了 v2.4 版本的候选稿。
                    看起来很棒，处理两个小问题后就可以发布：
                  </p>
                  <ol>
                    <li>
                      表单输入框的成功状态颜色
                      与 <code>bg-body-tertiary</code> 相比略显浅淡。
                      我们能否将边框对比度提升约 10%？
                    </li>
                    <li>
                      新的焦点环在浅色主题下效果很好，
                      但在深色主题下几乎看不见。
                      在发布前值得快速进行一次无障碍性检查。
                    </li>
                  </ol>
                  <p>
                    除此之外，赞一个！
                    客户一定会喜欢这些动画基础元素。
                  </p>
                  <p class="mb-0">
                    奥利维亚<br />
                    <small class="text-secondary">从我的笔记本电脑发送</small>
                  </p>
                </div>

                <!-- Attachments -->
                <h6 class="fw-semibold">附件 (2)</h6>
                <div class="row g-2 mb-3">
                  <div class="col-md-6">
                    <div class="card">
                      <div class="card-body py-2 px-3 d-flex align-items-center gap-2">
                        <i
                          class="bi bi-file-earmark-pdf-fill text-danger fs-3"
                          aria-hidden="true"
                        ></i>
                        <div class="flex-grow-1">
                          <p class="mb-0 small fw-semibold">设计审查.pdf</p>
                          <small class="text-secondary">1.4 MB</small>
                        </div>
                        <a href="#" class="btn btn-sm btn-outline-secondary">
                          <i class="bi bi-download" aria-hidden="true"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="card">
                      <div class="card-body py-2 px-3 d-flex align-items-center gap-2">
                        <i
                          class="bi bi-file-earmark-image-fill text-primary fs-3"
                          aria-hidden="true"
                        ></i>
                        <div class="flex-grow-1">
                          <p class="mb-0 small fw-semibold">黑色焦点环.png</p>
                          <small class="text-secondary">320 KB</small>
                        </div>
                        <a href="#" class="btn btn-sm btn-outline-secondary">
                          <i class="bi bi-download" aria-hidden="true"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="card-footer d-flex gap-2">
                <a
                  href={htmlPath + "/mailbox/compose.html"}
                  class="btn btn-primary"
                >
                  <i class="bi bi-reply me-1" aria-hidden="true"></i>回复
                </a>
                <button class="btn btn-outline-secondary" type="button">
                  <i class="bi bi-arrow-90deg-right me-1" aria-hidden="true"></i>
                  转发
                </button>
                <button class="btn btn-outline-secondary ms-auto" type="button">
                  <i class="bi bi-archive me-1" aria-hidden="true"></i>归档
                </button>
                <button class="btn btn-outline-danger" type="button">
                  <i class="bi bi-trash me-1" aria-hidden="true"></i>删除
                </button>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
  </body>
</html>

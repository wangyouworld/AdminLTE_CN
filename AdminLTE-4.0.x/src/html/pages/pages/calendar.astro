---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Calendar"
const path = "../../../dist"
const mainPage = "pages"
const page = "calendar";

// 智能路径解析：根据目录深度计算相对路径
const pathname = Astro.url.pathname;
const pathSegments = pathname.split('/').filter(segment => segment !== '');
const depth = pathSegments.length > 0 ? pathSegments.length - 1 : 0;
const deploymentPath = depth === 0 ? './' : '../'.repeat(depth);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head title={title} path={path} />
    <style is:inline>
      .fc-event {
        cursor: pointer;
      }
      .draggable-event {
        cursor: grab;
        user-select: none;
      }
    </style>
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">日历</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">首页</a></li>
                    <li class="breadcrumb-item active" aria-current="page">日历</li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="row g-3">
              <!-- Sidebar: draggable events -->
              <div class="col-lg-3">
                <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">可拖动事件</h3>
                  </div>
                  <div class="card-body">
                    <p class="text-secondary small mb-3">
                      将活动拖到日历中以安排它。
                    </p>
                    <div id="external-events">
                      <div
                        class="draggable-event badge text-bg-primary p-2 mb-2 d-block text-start"
                        data-color="#0d6efd"
                      >
                        <i class="bi bi-grip-vertical me-1" aria-hidden="true"></i>
                        团队站会
                      </div>
                      <div
                        class="draggable-event badge text-bg-success p-2 mb-2 d-block text-start"
                        data-color="#198754"
                      >
                        <i class="bi bi-grip-vertical me-1" aria-hidden="true"></i>
                        客户回访
                      </div>
                      <div
                        class="draggable-event badge text-bg-warning p-2 mb-2 d-block text-start"
                        data-color="#ffc107"
                      >
                        <i class="bi bi-grip-vertical me-1" aria-hidden="true"></i>
                        设计评审
                      </div>
                      <div
                        class="draggable-event badge text-bg-info p-2 mb-2 d-block text-start"
                        data-color="#0dcaf0"
                      >
                        <i class="bi bi-grip-vertical me-1" aria-hidden="true"></i>
                        与经理的一对一会议
                      </div>
                      <div
                        class="draggable-event badge text-bg-danger p-2 d-block text-start"
                        data-color="#dc3545"
                      >
                        <i class="bi bi-grip-vertical me-1" aria-hidden="true"></i>
                        发布时间窗口
                      </div>
                    </div>
                    <hr />
                    <div class="form-check form-switch">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        role="switch"
                        id="remove-after-drop"
                      />
                      <label
                        class="form-check-label small"
                        for="remove-after-drop"
                      >
                        移除后从列表中删除
                      </label>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Calendar -->
              <div class="col-lg-9">
                <div class="card">
                  <div class="card-body">
                    <div id="calendar"></div>
                  </div>
                  <div class="card-footer text-secondary small">
                    由
                    <a
                      href="https://fullcalendar.io/"
                      target="_blank"
                      rel="noopener">FullCalendar 6</a
                    >
                    驱动 &mdash; 采用 MIT 许可证，无 jQuery 依赖。
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
    <script
      src={deploymentPath + "assets/fullcalendar/index.global.min.js"}
      crossorigin="anonymous"></script>
    <script is:inline>
      const isoDate = (d) => d.toISOString().slice(0, 10);

      document.addEventListener("DOMContentLoaded", () => {
        const calendarEl = document.getElementById("calendar");
        const externalEl = document.getElementById("external-events");
        const removeAfterDrop = document.getElementById("remove-after-drop");

        new FullCalendar.Draggable(externalEl, {
          itemSelector: ".draggable-event",
          eventData: (el) => ({
            title: el.textContent.trim(),
            backgroundColor: el.dataset.color,
            borderColor: el.dataset.color
          })
        });

        const today = new Date();
        const offsetDay = (n) => {
          const d = new Date(today);
          d.setDate(today.getDate() + n);
          return isoDate(d);
        };

        const calendar = new FullCalendar.Calendar(calendarEl, {
          initialView: "dayGridMonth", locale: 'zh-cn', locale: 'zh-cn',
          headerToolbar: {
            start: "prev,next today",
            center: "title",
            end: "dayGridMonth,timeGridWeek,timeGridDay,listWeek"
          },
          height: 700,
          editable: true,
          droppable: true,
          dayMaxEvents: 3,
          drop: (info) => {
            if (removeAfterDrop.checked) {
              info.draggedEl.remove();
            }
          },
          dateClick: (info) => {
            const title = prompt("事件标题：");
            if (title) {
              calendar.addEvent({
                title: title,
                start: info.dateStr,
                allDay: info.allDay
              });
            }
          },
          eventClick: (info) => {
            if (confirm(`删除 "${info.event.title}"?`)) {
              info.event.remove();
            }
          },
          events: [
            { title: "季度规划", start: offsetDay(-2), backgroundColor: "#0d6efd", borderColor: "#0d6efd" },
            { title: "入职培训", start: offsetDay(1), backgroundColor: "#198754", borderColor: "#198754" },
            { title: "设计评审", start: offsetDay(3), end: offsetDay(4), backgroundColor: "#ffc107", borderColor: "#ffc107", textColor: "#000" },
            { title: "发布 v2.5", start: offsetDay(7), backgroundColor: "#dc3545", borderColor: "#dc3545" },
            { title: "全体成员", start: offsetDay(10), backgroundColor: "#6f42c1", borderColor: "#6f42c1" }
          ]
        });

        calendar.render();
      });
    </script>
  </body>
</html>

---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | 用户资料"
const path = "../../../dist"
const mainPage = "pages"
const page = "profile";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head title={title} path={path} />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h3 class="mb-0">用户资料</h3>
              </div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                  <li class="breadcrumb-item"><a href="#">首页</a></li>
                  <li class="breadcrumb-item"><a href="#">用户</a></li>
                  <li class="breadcrumb-item active" aria-current="page">资料</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="row g-3">
              <!-- Profile sidebar -->
              <div class="col-md-3">
                <!-- About card -->
                <div class="card">
                  <div class="card-body text-center">
                    <div
                      class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3"
                      style="width: 96px; height: 96px; font-size: 2rem;"
                      aria-hidden="true"
                    >
                      JD
                    </div>
                    <h3 class="h5 mb-0">Jane Doe</h3>
                    <p class="text-secondary mb-3">产品设计师</p>
                    <ul class="list-group list-group-flush text-start small">
                      <li
                        class="list-group-item d-flex justify-content-between px-0"
                      >
                        <span class="text-secondary">关注</span>
                        <span class="fw-semibold">1,322</span>
                      </li>
                      <li
                        class="list-group-item d-flex justify-content-between px-0"
                      >
                        <span class="text-secondary">粉丝</span>
                        <span class="fw-semibold">543</span>
                      </li>
                      <li
                        class="list-group-item d-flex justify-content-between px-0"
                      >
                        <span class="text-secondary">好友</span>
                        <span class="fw-semibold">13,287</span>
                      </li>
                    </ul>
                    <a href="#" class="btn btn-primary w-100 mt-3">
                      <i class="bi bi-person-plus me-1" aria-hidden="true"></i>
                      关注
                    </a>
                  </div>
                </div>
                <!-- About details -->
                <div class="card mt-3">
                  <div class="card-header">
                    <h3 class="card-title">关于</h3>
                  </div>
                  <div class="card-body small">
                    <p class="fw-semibold mb-1">
                      <i
                        class="bi bi-mortarboard me-1 text-secondary"
                        aria-hidden="true"
                      ></i>
                      教育经历
                    </p>
                    <p class="text-secondary mb-3">
                      田纳西大学诺克斯维尔分校
                      计算机科学理学学士
                    </p>
                    <p class="fw-semibold mb-1">
                      <i
                        class="bi bi-geo-alt me-1 text-secondary"
                        aria-hidden="true"
                      ></i>
                      位置
                    </p>
                    <p class="text-secondary mb-3">加利福尼亚州马里布</p>
                    <p class="fw-semibold mb-1">
                      <i
                        class="bi bi-tags me-1 text-secondary"
                        aria-hidden="true"
                      ></i>
                      技能
                    </p>
                    <p class="mb-3">
                      <span class="badge text-bg-secondary me-1">UI/UX</span>
                      <span class="badge text-bg-secondary me-1">Figma</span>
                      <span class="badge text-bg-secondary me-1">设计系统</span>
                      <span class="badge text-bg-secondary">研究</span>
                    </p>
                    <p class="fw-semibold mb-1">
                      <i
                        class="bi bi-pencil-square me-1 text-secondary"
                        aria-hidden="true"
                      ></i>
                      说明
                    </p>
                    <p class="text-secondary mb-0">
                      他是望闻问切加摸心脏看舌头，主观加客观地乱用，
                      可以说他用尽一切在无器械情况下能用的诊疗手段，但没有任何治疗手段。
                    </p>
                  </div>
                </div>
              </div>

              <!-- Tabbed content -->
              <div class="col-md-9">
                <div class="card">
                  <div class="card-header p-0 border-bottom-0">
                    <ul
                      class="nav nav-tabs"
                      id="profile-tabs"
                      role="tablist"
                    >
                      <li class="nav-item" role="presentation">
                        <button
                          class="nav-link active"
                          id="activity-tab"
                          data-bs-toggle="tab"
                          data-bs-target="#activity"
                          type="button"
                          role="tab"
                          aria-selected="true"
                        >
                          活动
                        </button>
                      </li>
                      <li class="nav-item" role="presentation">
                        <button
                          class="nav-link"
                          id="timeline-tab"
                          data-bs-toggle="tab"
                          data-bs-target="#timeline"
                          type="button"
                          role="tab"
                          aria-selected="false"
                        >
                          时间线
                        </button>
                      </li>
                      <li class="nav-item" role="presentation">
                        <button
                          class="nav-link"
                          id="settings-tab"
                          data-bs-toggle="tab"
                          data-bs-target="#settings"
                          type="button"
                          role="tab"
                          aria-selected="false"
                        >
                          设置
                        </button>
                      </li>
                    </ul>
                  </div>
                  <div class="card-body">
                    <div class="tab-content">
                      <!-- Activity tab -->
                      <div
                        class="tab-pane fade show active"
                        id="activity"
                        role="tabpanel"
                        aria-labelledby="activity-tab"
                      >
                        <article class="d-flex gap-3 mb-4">
                          <div
                            class="flex-shrink-0 rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center"
                            style="width: 40px; height: 40px;"
                            aria-hidden="true"
                          >
                            JD
                          </div>
                          <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                              <h4 class="h6 mb-0">Jane Doe</h4>
                              <small class="text-secondary">2 小时前</small>
                            </div>
                            <p class="mb-2">
                              已发布<a href="#">设计系统 v2.4</a>，
                              包含更新的配色方案和全新的动画基础元素。
                            </p>
                            <a href="#" class="btn btn-sm btn-outline-secondary">
                              <i
                                class="bi bi-hand-thumbs-up me-1"
                                aria-hidden="true"
                              ></i>
                              喜欢
                            </a>
                            <a
                              href="#"
                              class="btn btn-sm btn-outline-secondary ms-1"
                            >
                              <i
                                class="bi bi-chat me-1"
                                aria-hidden="true"
                              ></i>
                              评论
                            </a>
                          </div>
                        </article>
                        <article class="d-flex gap-3 mb-4">
                          <div
                            class="flex-shrink-0 rounded-circle bg-info-subtle text-info d-flex align-items-center justify-content-center"
                            style="width: 40px; height: 40px;"
                            aria-hidden="true"
                          >
                            JD
                          </div>
                          <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                              <h4 class="h6 mb-0">Jane Doe</h4>
                              <small class="text-secondary">昨天</small>
                            </div>
                            <p class="mb-2">
                              在 <a href="#">#design-help</a> 中
                              发了一个问题：对于深色主题的行动按钮，
                              我们该如何处理焦点环？
                            </p>
                          </div>
                        </article>
                        <article class="d-flex gap-3">
                          <div
                            class="flex-shrink-0 rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center"
                            style="width: 40px; height: 40px;"
                            aria-hidden="true"
                          >
                            JD
                          </div>
                          <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                              <h4 class="h6 mb-0">Jane Doe</h4>
                              <small class="text-secondary">3 天前</small>
                            </div>
                            <p class="mb-0">
                              更新了个人简介，
                              并将<em>“研究”</em> 添加到技能中。
                            </p>
                          </div>
                        </article>
                      </div>

                      <!-- Timeline tab -->
                      <div
                        class="tab-pane fade"
                        id="timeline"
                        role="tabpanel"
                        aria-labelledby="timeline-tab"
                      >
                        <ul class="list-unstyled mb-0">
                          <li class="d-flex gap-3 mb-3">
                            <span
                              class="badge text-bg-success rounded-pill flex-shrink-0 align-self-start mt-1"
                            >
                              <i class="bi bi-check-lg" aria-hidden="true"></i>
                            </span>
                            <div>
                              <p class="mb-0 fw-semibold">
                                发布设计系统 v2.4
                              </p>
                              <small class="text-secondary">2026年5月16日</small>
                            </div>
                          </li>
                          <li class="d-flex gap-3 mb-3">
                            <span
                              class="badge text-bg-info rounded-pill flex-shrink-0 align-self-start mt-1"
                            >
                              <i class="bi bi-mic" aria-hidden="true"></i>
                            </span>
                            <div>
                              <p class="mb-0 fw-semibold">
                                在本地用户体验交流会上发言
                              </p>
                              <small class="text-secondary">2026年4月22日</small>
                            </div>
                          </li>
                          <li class="d-flex gap-3">
                            <span
                              class="badge text-bg-warning rounded-pill flex-shrink-0 align-self-start mt-1"
                            >
                              <i class="bi bi-briefcase" aria-hidden="true"></i>
                            </span>
                            <div>
                              <p class="mb-0 fw-semibold">
                                加入产品团队担任高级设计师
                              </p>
                              <small class="text-secondary">2026年3月1日</small>
                            </div>
                          </li>
                        </ul>
                      </div>

                      <!-- Settings tab -->
                      <div
                        class="tab-pane fade"
                        id="settings"
                        role="tabpanel"
                        aria-labelledby="settings-tab"
                      >
                        <form class="row g-3">
                          <div class="col-md-6">
                            <label class="form-label" for="profile-first">
                              姓
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="profile-first"
                              value="Jane"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="profile-last">
                              名
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="profile-last"
                              value="Doe"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="profile-email">
                              邮箱
                            </label>
                            <input
                              type="email"
                              class="form-control"
                              id="profile-email"
                              value="jane@example.com"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="profile-role">
                              职位
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="profile-role"
                              value="产品设计师"
                            />
                          </div>
                          <div class="col-12">
                            <label class="form-label" for="profile-bio">Bio</label>
                            <textarea
                              class="form-control"
                              id="profile-bio"
                              rows="4">设计师，偏爱设计令牌与无障碍设计。</textarea>
                          </div>
                          <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                              保存修改
                            </button>
                            <button type="reset" class="btn btn-outline-secondary ms-1">
                              取消
                            </button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
  </body>
</html>

---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Settings"
const path = "../../../dist"
const mainPage = "pages"
const page = "settings";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head title={title} path={path} />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h3 class="mb-0">设置</h3>
              </div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                  <li class="breadcrumb-item"><a href="#">首页</a></li>
                  <li class="breadcrumb-item active" aria-current="page">设置</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="row g-3">
              <!-- Left rail -->
              <div class="col-md-3">
                <div
                  class="list-group list-group-flush nav nav-pills flex-column"
                  id="settings-nav"
                  role="tablist"
                >
                  <a
                    href="#account"
                    class="list-group-item list-group-item-action active"
                    data-bs-toggle="pill"
                    role="tab"
                    aria-selected="true"
                  >
                    <i class="bi bi-person me-2" aria-hidden="true"></i>账户
                  </a>
                  <a
                    href="#notifications"
                    class="list-group-item list-group-item-action"
                    data-bs-toggle="pill"
                    role="tab"
                  >
                    <i class="bi bi-bell me-2" aria-hidden="true"></i>通知
                  </a>
                  <a
                    href="#security"
                    class="list-group-item list-group-item-action"
                    data-bs-toggle="pill"
                    role="tab"
                  >
                    <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>安全
                  </a>
                  <a
                    href="#billing"
                    class="list-group-item list-group-item-action"
                    data-bs-toggle="pill"
                    role="tab"
                  >
                    <i class="bi bi-credit-card me-2" aria-hidden="true"></i>费用
                  </a>
                  <a
                    href="#danger"
                    class="list-group-item list-group-item-action text-danger"
                    data-bs-toggle="pill"
                    role="tab"
                  >
                    <i
                      class="bi bi-exclamation-triangle me-2"
                      aria-hidden="true"
                    ></i>
                    危险操作
                  </a>
                </div>
              </div>

              <!-- Tab content -->
              <div class="col-md-9">
                <div class="tab-content">
                  <!-- Account -->
                  <div
                    class="tab-pane fade show active"
                    id="account"
                    role="tabpanel"
                  >
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">账户</h3>
                      </div>
                      <div class="card-body">
                        <form class="row g-3">
                          <div class="col-md-6">
                            <label class="form-label" for="settings-name">
                              全名
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="settings-name"
                              value="Jane Doe"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="settings-email">
                              邮箱
                            </label>
                            <input
                              type="email"
                              class="form-control"
                              id="settings-email"
                              value="jane@example.com"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="settings-tz">
                              时区
                            </label>
                            <select class="form-select" id="settings-tz">
                              <option>UTC</option>
                              <option selected>美国/洛杉矶</option>
                              <option>欧洲/伦敦</option>
                              <option>亚洲/东京</option>
                            </select>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="settings-lang">
                              语言
                            </label>
                            <select class="form-select" id="settings-lang">
                              <option selected>英语</option>
                              <option>西班牙语</option>
                              <option>法语</option>
                              <option>德语</option>
                            </select>
                          </div>
                          <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                              保存修改
                            </button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                  <!-- Notifications -->
                  <div class="tab-pane fade" id="notifications" role="tabpanel">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">通知</h3>
                      </div>
                      <div class="card-body">
                        <p class="text-secondary">
                          选择要接收的通知。
                        </p>
                        {
                          [
                            ["产品更新", "重要发布和更新日志"],
                            ["安全提醒", "登录和账户变更"],
                            ["每周摘要", "工作区中的活动摘要"],
                            ["提及", "当队友 @提及 你时"]
                          ].map(([label, desc], i) => (
                            <div class="d-flex justify-content-between align-items-start py-2 border-bottom">
                              <div>
                                <p class="mb-0 fw-semibold">{label}</p>
                                <small class="text-secondary">{desc}</small>
                              </div>
                              <div class="form-check form-switch mb-0">
                                <input
                                  class="form-check-input"
                                  type="checkbox"
                                  role="switch"
                                  id={`notif-${i}`}
                                  checked={i < 2}
                                />
                                <label
                                  class="visually-hidden"
                                  for={`notif-${i}`}
                                >
                                  切换 {label}
                                </label>
                              </div>
                            </div>
                          ))
                        }
                        <button class="btn btn-primary mt-3">保存设置</button>
                      </div>
                    </div>
                  </div>

                  <!-- Security -->
                  <div class="tab-pane fade" id="security" role="tabpanel">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">密码</h3>
                      </div>
                      <div class="card-body">
                        <form class="row g-3">
                          <div class="col-md-12">
                            <label class="form-label" for="pwd-current">
                              当前密码
                            </label>
                            <input
                              type="password"
                              class="form-control"
                              id="pwd-current"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="pwd-new">
                              新密码
                            </label>
                            <input type="password" class="form-control" id="pwd-new" />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="pwd-confirm">
                              确认新密码
                            </label>
                            <input
                              type="password"
                              class="form-control"
                              id="pwd-confirm"
                            />
                          </div>
                          <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                              更新密码
                            </button>
                          </div>
                        </form>
                      </div>
                    </div>
                    <div class="card mt-3">
                      <div class="card-header">
                        <h3 class="card-title">双因素认证</h3>
                      </div>
                      <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                          <p class="mb-0 fw-semibold">身份验证 APP</p>
                          <small class="text-secondary">
                            使用 1Password 或 Authy 等身份验证 APP。
                          </small>
                        </div>
                        <button class="btn btn-outline-primary">启用</button>
                      </div>
                    </div>
                  </div>

                  <!-- Billing -->
                  <div class="tab-pane fade" id="billing" role="tabpanel">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">当前计划</h3>
                      </div>
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                          <div>
                            <p class="mb-0 fw-semibold">提前计划</p>
                            <small class="text-secondary">
                              每月 29 美元 · 2026 年 6 月 18 日续费
                            </small>
                          </div>
                          <a href="#" class="btn btn-outline-primary btn-sm">
                            保存计划
                          </a>
                        </div>
                        <hr />
                        <p class="fw-semibold mb-2">付款方式</p>
                        <div class="d-flex justify-content-between align-items-center">
                          <div>
                            <i
                              class="bi bi-credit-card-2-front me-2"
                              aria-hidden="true"
                            ></i>
                            尾号为 4242 的 Visa 卡
                          </div>
                          <a href="#" class="btn btn-link btn-sm">更新</a>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- 危险操作 -->
                  <div class="tab-pane fade" id="danger" role="tabpanel">
                    <div class="card border-danger">
                      <div class="card-header bg-danger-subtle">
                        <h3 class="card-title text-danger">危险操作</h3>
                      </div>
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                          <div>
                            <p class="mb-0 fw-semibold">导出账户数据</p>
                            <small class="text-secondary">
                              将所有数据下载为 ZIP 压缩包。
                            </small>
                          </div>
                          <button class="btn btn-outline-secondary">导出</button>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-start">
                          <div>
                            <p class="mb-0 fw-semibold text-danger">
                              删除账户
                            </p>
                            <small class="text-secondary">
                              这将永久删除您的账户及所有关联数据。
                              此操作不可撤销。
                            </small>
                          </div>
                          <button class="btn btn-danger">删除账户</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
  </body>
</html>

---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"
import SkinPreview from "@components/_skin-preview.astro"
import { palette, paletteV3, sets, skinGroups, skinGroupsV3, skins, skinsV3 } from "../../../utils/palette.mjs"

const title = "AdminLTE 4 | 颜色"
const path = "../../../dist"
const mainPage = "ui-elements"
const page = "colors"
const pageTitle = "颜色"

// 本页面是唯一一个加载了可选扩展调色板（dist/css/adminlte-colors.css）的演示页。
// 这里用到的任何东西都不在 adminlte.css 里。
const pathname = Astro.url.pathname
const pathSegments = pathname.split("/").filter(segment => segment !== "")
const depth = pathSegments.length > 0 ? pathSegments.length - 1 : 0
const deploymentPath = depth === 0 ? "./" : "../".repeat(depth)

const chromatic = palette.filter(c => c.role === "chromatic")
const neutral = palette.filter(c => c.role === "neutral")
const names = palette.map(c => c.name)
// 本页面可以由两套调色板来驱动：4.4 重新设计的那套（默认）或者 AdminLTE 3 的原版。
// 两个样式表定义的是同一批类名、只是取值不同，所以页面一次只加载一个，
// 通过替换 <link> 来切换。
const paletteSets = [
  { key: "designed" as const, label: "设计配色方案 (4.4)", file: "adminlte-colors.css", groups: skinGroups, skins, choices: ["default", ...palette.map(c => c.name)] },
  { key: "v3" as const, label: "AdminLTE 3 原版", file: "adminlte-colors-v3.css", groups: skinGroupsV3, skins: skinsV3, choices: ["default", ...paletteV3.map(c => c.name)] }
]
// 名称 → 自动文字颜色，按套、按对比度模式区分。v3 用的是 YIQ 规则
//（有些颜色配深色文字）；`data-lte-contrast="aa"` 会把那些指定文字
// 达不到 WCAG AA 的颜色翻转过来（#6110）。
const paletteText = JSON.stringify({
  designed: {
    default: Object.fromEntries(palette.map(c => [c.name, c.textColor])),
    aa: Object.fromEntries(palette.map(c => [c.name, c.textColorAA]))
  },
  v3: {
    default: Object.fromEntries(paletteV3.map(c => [c.name, c.textColor])),
    aa: Object.fromEntries(paletteV3.map(c => [c.name, c.textColorAA]))
  }
})
// `data-lte-contrast="aa"` 实际会改动哪些颜色，按调色板区分
const aaFlips = {
  designed: palette.filter(c => c.textColor !== c.textColorAA),
  v3: paletteV3.filter(c => c.textColor !== c.textColorAA)
}
const utilityRows = [
  { label: ".bg-*", cell: (n: string) => `<div class="lte-swatch bg-${n}"></div>` },
  { label: ".text-bg-*", cell: (n: string) => `<div class="lte-swatch text-bg-${n}">Aa</div>` },
  { label: ".bg-* .bg-opacity-25", cell: (n: string) => `<div class="lte-swatch bg-${n} bg-opacity-25"></div>` },
  { label: ".bg-gradient-*", cell: (n: string) => `<div class="lte-swatch bg-gradient-${n}"></div>` },
  { label: ".text-*", cell: (n: string) => `<div class="lte-swatch bg-white fw-semibold text-${n}">Aa</div>` },
  { label: ".border-*", cell: (n: string) => `<div class="lte-swatch border border-3 border-${n}"></div>` },
  { label: ".link-*", cell: (n: string) => `<div class="lte-swatch bg-white"><a href="#" class="link-${n} link-underline-opacity-25 link-underline-opacity-100-hover">链接</a></div>` },
  { label: ".callout-*", cell: (n: string) => `<div class="callout callout-${n} py-2 px-2 mb-0 small text-center rounded-1">淡色</div>` }
]
const smallBoxNumbers = ["2,341", "$18.4k", "318", "97%"]
const smallBoxLabels = ["活跃用户", "营收", "支持工单", "在线率"]
const smallBoxIcons = ["bi-people", "bi-cash-stack", "bi-chat-dots", "bi-check-lg"]
---

<!doctype html>
<html lang="zh-CN">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
    <!--begin::Optional Stylesheet(Extended palette — only this page loads it)-->
    <link rel="stylesheet" href={deploymentPath + "css/adminlte-colors.css"} id="palette-stylesheet" data-css-dir={deploymentPath + "css/"} />
    <script type="application/json" id="palette-text" set:html={paletteText} />
    <!--end::Optional Stylesheet(Extended palette)-->
    <style>
      /* Page-local helpers for the swatch tables; not part of AdminLTE. */
      .lte-swatch {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 2.5rem;
        font-size: 0.875rem;
        border-radius: var(--bs-border-radius);
      }
      .lte-chip {
        width: 2rem;
        height: 2rem;
        padding: 0;
        border-radius: var(--bs-border-radius);
        border: 1px solid rgba(var(--bs-body-color-rgb), 0.18);
      }
      .lte-chip[aria-pressed="true"] {
        outline: 2px solid var(--bs-body-color);
        outline-offset: 2px;
      }
      .lte-tile {
        min-height: 9rem;
        border-radius: var(--bs-border-radius);
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
      }
      .lte-skin-btn {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.4rem 0.3rem;
        font-size: 0.8125rem;
        line-height: 1.2;
        color: var(--bs-body-color);
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: var(--bs-border-radius);
      }
      .lte-skin-btn:hover {
        border-color: var(--bs-secondary-color);
      }
      .lte-skin-btn[aria-pressed="true"] {
        border-color: var(--bs-body-color);
        box-shadow: 0 0 0 1px var(--bs-body-color);
      }
      .lte-skin-btn:focus-visible {
        outline: 2px solid var(--bs-focus-ring-color);
        outline-offset: 2px;
      }
    </style>
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <!--begin::App Wrapper-->
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <!--begin::App Main-->
      <main class="app-main">
        <!--begin::App Content Header-->
        <div class="app-content-header">
          <!--begin::Container-->
          <div class="container-fluid">
            <!--begin::Row-->
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">{pageTitle}</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">首页</a></li>
                    <li class="breadcrumb-item active" aria-current="page">
                      {pageTitle}
                    </li>
                  </ol>
                </nav>
              </div>
            </div>
            <!--end::Row-->
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content Header-->
        <!--begin::App Content-->
        <div class="app-content">
          <!--begin::Container-->
          <div class="container-fluid">
            <div class="callout callout-info mb-4">
              <p>
                本页面加载了可选的
                <code>dist/css/adminlte-colors.css</code> —— 十四种额外颜色
                (orange, amber, olive, teal, sky, indigo, violet, fuchsia, pink,
                navy、steel、slate、graphite、midnight），以 <code>--bs-*</code> token 的形式提供，外加
                <code>.bg-*</code>, <code>.text-bg-*</code>, <code>.text-*</code>,
                <code>.border-*</code>, <code>.link-*</code>, <code>.bg-gradient-*</code>,
                <code>.card-*</code>, <code>.callout-*</code> and <code>.direct-chat-*</code>
                这几套类系列 —— 还有 <code>data-lte-primary</code>，
                它能让其中任意一个颜色成为 Bootstrap 的 <code>primary</code>，
                按钮什么的全都跟着变。它不属于 <code>adminlte.css</code> 的一部分；演示里也没有别的地方用到它。
              </p>
              <p class="mb-0">
                每一种颜色配白色文字都能达到 4.6:1 或更好，
                而且在排布时都考虑到了要跟 Bootstrap 自己的主题色相邻而不冲突。
                更喜欢 AdminLTE 3 原封不动的颜色？第二个样式表
                <code>dist/css/adminlte-colors-v3.css</code> 会把它们以原来的名字提供出来 ——
                在下面把本页面切换过去即可。具体的做法和原因在
                <a href={deploymentPath + "docs/colors.html"} class="callout-link">颜色文档页面</a>上。
              </p>
            </div>

            <!--begin::Palette switch-->
            <div class="card mb-4">
              <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <div class="me-auto">
                  <p class="fw-semibold mb-1">本页调色板</p>
                  <p class="text-body-secondary small mb-0">
                    <span data-palette-set="designed">在 OKLCH 里设计的十四种颜色 —— 每一种都配白色文字，并且能干净利落地和 Bootstrap 的主题色并排相处。</span>
                    <span data-palette-set="v3" hidden>十八种 AdminLTE 3 颜色，取值不变，沿用 v3 的文字颜色规则（lime、orange、yellow 配深色文字）。类系列相同。其中好几种配白色文字达不到 WCAG AA，跟 v3 里一样。</span>
                  </p>
                </div>
                <div class="btn-group" role="group" aria-label="Palette stylesheet">
                  {
                    paletteSets.map((set, i) => (
                      <button type="button" class:list={["btn btn-outline-secondary", i === 0 && "active"]} data-palette-switch={set.key} data-palette-file={set.file} aria-pressed={i === 0 ? "true" : "false"}>
                        {set.label}
                      </button>
                    ))
                  }
                </div>
              </div>
              <div class="card-footer">
                <div class="form-check form-switch mb-2">
                  <input class="form-check-input" type="checkbox" role="switch" id="contrast-aa" />
                  <label class="form-check-label" for="contrast-aa">
                    强制使用 WCAG AA 文字 — <code class="text-body-emphasis">data-lte-contrast="aa"</code>
                  </label>
                </div>
                {
                  paletteSets.map((set, i) => (
                    <p class="text-body-secondary small mb-0" data-palette-set={set.key} hidden={i !== 0}>
                      {
                        aaFlips[set.key].length === 0 ?
                          "这个调色板没有任何变化：每个颜色在与所赋予的文本配合时，其对比度已达到4.5:1。" :
                          <Fragment>
                            在 {set.choices.length - 1} 种颜色里，会把其中 {aaFlips[set.key].length} 种颜色上指定文字达不到 4.5:1 的文字翻转过来 — {aaFlips[set.key].map((c, j) => (
                              <Fragment>{j > 0 ? ", " : ""}<code>{c.name}</code> ({c.contrastWhite.toFixed(2)}:1 → {c.contrastBlack.toFixed(2)}:1)</Fragment>
                            ))}. 背景色保持它们的确切取值不变。
                          </Fragment>
                      }
                    </p>
                  ))
                }
              </div>
            </div>
            <!--end::Palette switch-->

            <!--begin::Skins-->
            <h5 class="mb-3">在本页面尝试皮肤</h5>
            <div class="card mb-4">
              <div class="card-body">
                <p>
                  所谓皮肤，就是侧边栏和头部上的一个背景工具类加上 <code>data-bs-theme</code>
                   —— 它本身没有任何 CSS。
                  下面的按钮会重新给<em>本页面的</em>侧边栏和头部上色，
                  方便你就地判断一个组合好不好看；
                  它们生成的标记会印在下面。
                  至于页脚、Bootstrap 自带的背景以及自由混搭，
                  请用 <a href={deploymentPath + "generate/theme.html"}>主题自定义</a> 页面 ——
                  它的取色器把调色板列在 "扩展调色板" 下面。
                </p>
                {
                  paletteSets.map((set, i) => (
                    <div data-palette-set={set.key} hidden={i !== 0}>
                      <div class="skin-presets">
                        {
                          set.groups.map(group => (
                            <div class="mb-3">
                              <p class="fw-semibold mb-1">{group.name}</p>
                              <p class="text-body-secondary small mb-2">{group.note}</p>
                              <div class="d-flex flex-wrap gap-2">
                                {
                                  set.skins.filter(skin => skin.group === group.name).map(skin => (
                                    <button
                                      type="button"
                                      class="lte-skin-btn"
                                      data-skin-header={skin.header.cls}
                                      data-skin-header-theme={skin.header.theme}
                                      data-skin-sidebar={skin.sidebar.cls}
                                      data-skin-sidebar-theme={skin.sidebar.theme}
                                      data-skin-primary={skin.primary}
                                      title={skin.note}
                                      aria-pressed="false"
                                    >
                                      <SkinPreview skin={skin} />
                                      <span>{skin.name}</span>
                                    </button>
                                  ))
                                }
                              </div>
                            </div>
                          ))
                        }
                      </div>
                      <div class="row g-4">
                        <div class="col-lg-6">
                          <p class="fw-semibold mb-2">侧边栏颜色</p>
                          <div class="d-flex flex-wrap gap-2" data-skin-picker="sidebar" role="group" aria-label="侧边栏颜色">
                            {
                              set.choices.map(name => (
                                <button
                                  type="button"
                                  class:list={["lte-chip", name === "default" ? "bg-body-secondary" : `text-bg-${name}`]}
                                  data-color={name}
                                  title={name === "default" ? "Default (bg-body-secondary)" : `.text-bg-${name}`}
                                  aria-pressed={name === "default" ? "true" : "false"}
                                >
                                  <span class="visually-hidden">{name === "default" ? "Default" : name}</span>
                                </button>
                              ))
                            }
                          </div>
                        </div>
                        <div class="col-lg-6">
                          <p class="fw-semibold mb-2">页眉颜色</p>
                          <div class="d-flex flex-wrap gap-2" data-skin-picker="header" role="group" aria-label="页眉颜色">
                            {
                              set.choices.map(name => (
                                <button
                                  type="button"
                                  class:list={["lte-chip", name === "default" ? "bg-body border" : `text-bg-${name}`]}
                                  data-color={name}
                                  title={name === "default" ? "Default (bg-body)" : `.text-bg-${name}`}
                                  aria-pressed={name === "default" ? "true" : "false"}
                                >
                                  <span class="visually-hidden">{name === "default" ? "Default" : name}</span>
                                </button>
                              ))
                            }
                          </div>
                        </div>
                      </div>
                    </div>
                  ))
                }
                <pre class="bg-body-tertiary rounded p-3 mt-4 mb-0 small overflow-auto" tabindex="0"><code id="skin-markup"></code></pre>
              </div>
            </div>
            <!--end::Skins-->

            <!--begin::Primary-->
            <h5 class="mb-3">选择其中一个成为你的 <code class="text-body-emphasis">primary</code></h5>
            <div class="card mb-4">
              <div class="card-body">
                <p>
                  Bootstrap 会把 <code>$primary</code> 编译进它的组件里，
                  所以 <code>.btn-primary</code> 带的是
                  <code>--bs-btn-bg: #0d6efd</code>，而不是
                  <code>var(--bs-primary)</code> —— 光覆盖那个 token，
                  按钮还是蓝色的。这个样式表把这些组件重新接了线，并
                  在你给 <code>&lt;html&gt;</code> 加上
                  <code>data-lte-primary</code> 时，让它们指向某个调色板颜色。
                  按钮、链接、分页、复选框、焦点圈、进度条、
                  激活的列表项和下拉项都会跟着变；
                  不加这个属性的话什么都不变。
                </p>
                {
                  paletteSets.map((set, i) => (
                    <div data-palette-set={set.key} hidden={i !== 0}>
                      <div class="d-flex flex-wrap gap-2" data-primary-picker role="group" aria-label="Primary colour">
                        {
                          set.choices.map(name => (
                            <button
                              type="button"
                              class:list={["lte-chip", name !== "default" && `text-bg-${name}`]}
                              data-color={name}
                              style={name === "default" ? "background-color: #0d6efd" : undefined}
                              title={name === "default" ? "Bootstrap's blue (no attribute)" : `data-lte-primary="${name}"`}
                              aria-pressed={name === "default" ? "true" : "false"}
                            >
                              <span class="visually-hidden">{name === "default" ? "Bootstrap 默认" : name}</span>
                            </button>
                          ))
                        }
                      </div>
                    </div>
                  ))
                }
                <div class="row g-3 align-items-center mt-1">
                  <div class="col-auto">
                    <button type="button" class="btn btn-primary">Primary 按钮</button>
                  </div>
                  <div class="col-auto">
                    <button type="button" class="btn btn-outline-primary">描边</button>
                  </div>
                  <div class="col-auto">
                    <a href="#primary-preview">一个链接</a>
                  </div>
                  <div class="col-auto">
                    <span class="badge text-bg-primary">徽章</span>
                  </div>
                  <div class="col-auto">
                    <div class="form-check mb-0">
                      <input class="form-check-input" type="checkbox" id="primary-check" checked />
                      <label class="form-check-label" for="primary-check">选中</label>
                    </div>
                  </div>
                  <div class="col-auto">
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" role="switch" id="primary-switch" checked />
                      <label class="form-check-label" for="primary-switch">开关</label>
                    </div>
                  </div>
                  <div class="col-12 col-md-5">
                    <label for="primary-input" class="form-label small text-body-secondary mb-1">聚焦此字段</label>
                    <input type="text" class="form-control" id="primary-input" placeholder="焦点圈也会跟着变" />
                  </div>
                  <div class="col-12 col-md-4">
                    <div class="progress" role="progressbar" aria-label="Example progress" aria-valuenow="62" aria-valuemin="0" aria-valuemax="100">
                      <div class="progress-bar" style="width: 62%">62%</div>
                    </div>
                  </div>
                  <div class="col-auto">
                    <nav aria-label="Example pagination">
                      <ul class="pagination mb-0">
                        <li class="page-item active" aria-current="page"><span class="page-link">1</span></li>
                        <li class="page-item"><a class="page-link" href="#primary-preview">2</a></li>
                        <li class="page-item"><a class="page-link" href="#primary-preview">3</a></li>
                      </ul>
                    </nav>
                  </div>
                </div>
                <pre class="bg-body-tertiary rounded p-3 mt-4 mb-0 small overflow-auto" tabindex="0" id="primary-preview"><code id="primary-markup"></code></pre>
              </div>
            </div>
            <!--end::Primary-->

            <!--begin::Palette-->
            <h5 class="mb-3">调色板</h5>
            <div data-palette-set="designed">
              <div class="row g-3 mb-2">
                {
                  chromatic.map(c => (
                    <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                      <div class={`lte-tile p-3 h-100 d-flex flex-column justify-content-between text-bg-${c.name}`}>
                        <div>
                          <div class="fw-bold font-monospace">.bg-{c.name}</div>
                          <div class="small opacity-90 mt-1">{c.description}</div>
                        </div>
                        <div class="small font-monospace mt-3">
                          {c.hex}<br />{c.oklchLabel}<br />white {c.contrastWhite.toFixed(1)}:1
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
              <div class="row g-3 mb-4">
                {
                  neutral.map(c => (
                    <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                      <div class={`lte-tile p-3 h-100 d-flex flex-column justify-content-between text-bg-${c.name}`}>
                        <div>
                          <div class="fw-bold font-monospace">.bg-{c.name}</div>
                          <div class="small opacity-90 mt-1">{c.description}</div>
                        </div>
                        <div class="small font-monospace mt-3">
                          {c.hex}<br />{c.oklchLabel}<br />white {c.contrastWhite.toFixed(1)}:1
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
            <div data-palette-set="v3" hidden>
              <div class="row g-3 mb-4">
                {
                  paletteV3.map(c => (
                    <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                      <div class={`lte-tile p-3 h-100 d-flex flex-column justify-content-between text-bg-${c.name}`}>
                        <div>
                          <div class="fw-bold font-monospace">.bg-{c.name}</div>
                          {c.note && <div class="small opacity-90 mt-1">{c.note}</div>}
                        </div>
                        <div class="small font-monospace mt-3">
                          {c.hex}<br />white {c.contrastWhite.toFixed(1)}:1 · black {c.contrastBlack.toFixed(1)}:1
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
              <p class="text-body-secondary">
                工具类、组件和仪表盘配色组都是用重新设计的那套调色板来演示的；v3 那个样式表为这十八个名字输出的类系列完全一样。
              </p>
            </div>
            <!--end::Palette-->

            <div data-palette-set="designed">
            <!--begin::Sets-->
            <h5 class="mb-3">仪表板设置</h5>
            <p class="text-body-secondary">
              一行组件上该放哪四种颜色，往往就是"随便挑"最容易钻空子的地方。
              下面这些四色组合是按色相关系选出来的。
              它们只是推荐，不是类。
            </p>
            {
              sets.map(set => (
                <div class="card mb-4">
                  <div class="card-header">
                    <h3 class="card-title">{set.name}</h3>
                    <div class="card-tools">
                      {set.colors.map(c => <code class="text-body-emphasis me-2">text-bg-{c}</code>)}
                    </div>
                  </div>
                  <div class="card-body">
                    <p class="text-body-secondary">{set.why}</p>
                    <div class="row">

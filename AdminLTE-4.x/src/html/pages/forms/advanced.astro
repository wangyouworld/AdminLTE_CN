---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | 高级元素"
const path = "../../../dist"
const mainPage = "forms"
const page = "advanced";

// 智能路径解析：根据目录深度计算相对路径
const pathname = Astro.url.pathname;
const pathSegments = pathname.split('/').filter(segment => segment !== '');
const depth = pathSegments.length > 0 ? pathSegments.length - 1 : 0;
const deploymentPath = depth === 0 ? './' : '../'.repeat(depth);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head title={title} path={path} />
    <link
      rel="stylesheet"
      href={deploymentPath + "assets/tom-select/tom-select.bootstrap5.min.css"}
      integrity="sha384-qNqaCnsmyTrYVwmqv4/4PcwMK8ZFAQnYPpVjWor+6cX6rKsPhebzu8vO2J3s+VZg"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href={deploymentPath + "assets/flatpickr/flatpickr.min.css"}
      integrity="sha384-RkASv+6KfBMW9eknReJIJ6b3UnjKOKC5bOUaNgIY778NFbQ8MtWq9Lr/khUgqtTt"
      crossorigin="anonymous"
    />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">高级元素</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">首页</a></li>
                    <li class="breadcrumb-item"><a href="#">表单</a></li>
                    <li class="breadcrumb-item active" aria-current="page">高级元素</li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="row g-4">
              <div class="col-12">
                <div class="callout callout-info">
                  AdminLTE 有意不捆绑表单控件。
                  本页面上的控件使用了推荐的第三方集成——
                  <a
                    href="https://tom-select.js.org/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="callout-link"
                  >Tom Select</a>
                  和
                  <a
                    href="https://flatpickr.js.org/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="callout-link"
                  >Flatpickr</a>.
                  查看
                  <a href="../docs/integrations.html" class="callout-link">推荐集成</a>
                  页包含完整列表及安装代码片段。
                </div>
              </div>

              <!-- Tom Select -->
              <div class="col-md-6">
                <div class="card card-primary card-outline mb-4">
                  <div class="card-header">
                    <div class="card-title">Tom Select</div>
                  </div>
                  <div class="card-body">
                    <div class="mb-4">
                      <label for="country" class="form-label">单选并搜索</label>
                      <select id="country" class="form-control" aria-label="单选并搜索">
                        <option value="">选择一个国家&hellip;</option>
                        <option>澳大利亚</option>
                        <option>巴西</option>
                        <option>加拿大</option>
                        <option>法国</option>
                        <option>德国</option>
                        <option>意大利</option>
                        <option>日本</option>
                        <option>拉脱维亚</option>
                        <option>荷兰</option>
                        <option>西班牙</option>
                        <option>英国</option>
                        <option>美国</option>
                      </select>
                      <div class="form-text">
                        开始输入即可筛选列表；&times; 按钮
                        用来清除选择（<code>clear_button</code>）。
                      </div>
                    </div>
                    <div class="mb-4">
                      <label for="post-tags" class="form-label">多选带标签</label>
                      <select id="post-tags" class="form-control" aria-label="多选带标签" multiple>
                        <option value="bootstrap" selected>Bootstrap</option>
                        <option value="javascript" selected>JavaScript</option>
                        <option value="css">CSS</option>
                        <option value="accessibility">无障碍访问</option>
                        <option value="performance">性能</option>
                        <option value="tooling">工具</option>
                      </select>
                      <div class="form-text">
                        输入以筛选，按 Enter 创建新标签，使用
                        &times; 按钮移除标签。
                      </div>
                    </div>
                    <div>
                      <label for="reviewer" class="form-label">带分页的远程数据</label>
                      <select id="reviewer" class="form-control" aria-label="带分页的远程数据"></select>
                      <div class="form-text">
                        背后是一个模拟接口，挂着 72 条记录。
                        输入做了防抖处理（<code>loadThrottle</code>），
                        过期的请求会用 <code>AbortController</code> 取消掉，
                        滚动到列表底部时会自动加载下一页
                        （<code>virtual_scroll</code>）。
                      </div>
                    </div>
                  </div>
                  <div class="card-footer text-body-secondary small">
                    由
                    <a
                      href="https://tom-select.js.org/"
                      target="_blank"
                      rel="noopener"
                      class="link-body-emphasis"
                    >Tom Select</a>
                    &mdash; 提供支持 — 基于纯 JS，无需 jQuery。
                  </div>
                </div>
              </div>

              <!-- Flatpickr -->
              <div class="col-md-6">
                <div class="card card-success card-outline mb-4">
                  <div class="card-header">
                    <div class="card-title">Flatpickr</div>
                  </div>
                  <div class="card-body">
                    <div class="mb-4">
                      <label for="delivery-date" class="form-label">日期选择</label>
                      <input
                        type="text"
                        id="delivery-date"
                        class="form-control"
                        placeholder="选择配送日期"
                      />
                    </div>
                    <div class="mb-4">
                      <label for="meeting-start" class="form-label">日期 &amp; 时间选择器</label>
                      <input
                        type="text"
                        id="meeting-start"
                        class="form-control"
                        placeholder="选择日期和时间"
                      />
                    </div>
                    <div class="mb-4">
                      <label for="report-period" class="form-label">范围选择</label>
                      <input
                        type="text"
                        id="report-period"
                        class="form-control"
                        placeholder="选择报告周期"
                      />
                      <div class="form-text">选择一个开始日期，然后选择一个结束日期。</div>
                    </div>
                    <div>
                      <label for="reminder-time" class="form-label">时间选择</label>
                      <input
                        type="text"
                        id="reminder-time"
                        class="form-control"
                        placeholder="选择时间"
                      />
                    </div>
                  </div>
                  <div class="card-footer text-body-secondary small">
                    由
                    <a
                      href="https://flatpickr.js.org/"
                      target="_blank"
                      rel="noopener"
                      class="link-body-emphasis"
                    >Flatpickr</a>
                    &mdash; 提供支持 — 基于纯 JS，无需 jQuery。
                  </div>
                </div>
              </div>

              <!-- Select2 → Tom Select -->
              <div class="col-12" id="select2">
                <div class="card card-secondary card-outline mb-4">
                  <div class="card-header">
                    <div class="card-title">来自 Select2？</div>
                  </div>
                  <div class="card-body">
                    <p>
                      <a
                        href="https://select2.org/"
                        target="_blank"
                        rel="noopener noreferrer"
                      >下拉菜单2</a>
                      目前仍在维护，但它依然是个 jQuery 插件 &mdash; 没有不依赖 jQuery 的构建版本。
                      Tom Select 能覆盖同样的功能集，
                      体积大约只有 <strong>20&nbsp;kB gzip</strong>，
                      而 Select2 算上 jQuery 之后大约是 <strong>~50&nbsp;kB</strong>。
                      两者的 API 几乎可以一一对应：
                    </p>
                    <div
                      class="table-responsive"
                      tabindex="0"
                      role="region"
                      aria-label="Select2 to Tom Select API mapping"
                    >
                      <table class="table table-sm table-striped align-middle mb-0">
                        <caption class="visually-hidden">
                          将 Select2 的选项和方法映射到其 Tom Select 对应的版本
                        </caption>
                        <thead>
                          <tr>
                            <th scope="col" style="width: 50%;">下拉菜单2</th>
                            <th scope="col">Tom Select</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            <td><code>$("#x").select2()</code></td>
                            <td><code>new TomSelect("#x")</code></td>
                          </tr>
                          <tr>
                            <td><code>tags: true</code></td>
                            <td><code>create: true</code></td>
                          </tr>
                          <tr>
                            <td><code>allowClear: true</code></td>
                            <td><code>plugins: ["clear_button"]</code></td>
                          </tr>
                          <tr>
                            <td><code>closeOnSelect: false</code></td>
                            <td><code>closeAfterSelect: false</code></td>
                          </tr>
                          <tr>
                            <td><code>maximumSelectionLength: 3</code></td>
                            <td><code>maxItems: 3</code></td>
                          </tr>
                          <tr>
                            <td><code>minimumInputLength: 2</code></td>
                            <td><code>shouldLoad: (q) =&gt; q.length &gt;= 2</code></td>
                          </tr>
                          <tr>
                            <td><code>ajax: &#123; url, delay: 250 &#125;</code></td>
                            <td><code>load(query, callback)</code> + <code>loadThrottle: 250</code></td>
                          </tr>
                          <tr>
                            <td><code>ajax.processResults</code></td>
                            <td><code>valueField</code> / <code>labelField</code> / <code>searchField</code></td>
                          </tr>
                          <tr>
                            <td>无限滚动 (<code>pagination.more</code>)</td>
                            <td><code>plugins: ["virtual_scroll"]</code> + <code>setNextUrl()</code></td>
                          </tr>
                          <tr>
                            <td><code>templateResult</code> / <code>templateSelection</code></td>
                            <td><code>render: &#123; option, item &#125;</code></td>
                          </tr>
                          <tr>
                            <td><code>dropdownParent: $("#modal")</code></td>
                            <td class="text-body-secondary">
                              无需——下拉菜单以内联方式显示
                            </td>
                          </tr>
                          <tr>
                            <td><code>$("#x").val("2").trigger("change")</code></td>
                            <td><code>ts.setValue("2")</code></td>
                          </tr>
                          <tr>
                            <td><code>$("#x").val()</code></td>
                            <td><code>ts.getValue()</code></td>
                          </tr>
                          <tr>
                            <td><code>.on("select2:select", fn)</code></td>
                            <td><code>ts.on("item_add", fn)</code></td>
                          </tr>
                          <tr>
                            <td><code>.on("change", fn)</code></td>
                            <td><code>ts.on("change", fn)</code></td>
                          </tr>
                          <tr>
                            <td><code>$("#x").select2("open")</code></td>
                            <td><code>ts.open()</code></td>
                          </tr>
                          <tr>
                            <td><code>$("#x").prop("disabled", true)</code></td>
                            <td><code>ts.disable()</code></td>
                          </tr>
                          <tr>
                            <td><code>$("#x").select2("destroy")</code></td>
                            <td><code>ts.destroy()</code></td>
                          </tr>
                          <tr>
                            <td><code>$("#x").empty().select2(&#123; data &#125;)</code></td>
                            <td><code>ts.clearOptions(); ts.addOptions(data)</code></td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                  <div class="card-footer text-body-secondary small">
                    暂时还锁死在 Select2 上？AdminLTE 提供了一个纯样式的
                    <a
                      href="../docs/integrations.html#select2-compatibility-theme"
                      class="link-body-emphasis"
                    >下拉菜单2 兼容主题</a>，
                    让它看起来和 Bootstrap 5.3 一致 &mdash; 包括深色模式和模态框里的下拉菜单。
                    AdminLTE 本身不会引入 jQuery；插件你自己带，
                    样式我们来搞定。
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
    <script
      src={deploymentPath + "assets/tom-select/tom-select.complete.min.js"}
      integrity="sha384-OgdLxftmuTHirLYFRbvXsKJxgSVqpU4ZdZ07tRiBC+Z4GjtQ5Al0uika0gtMfeQw"
      crossorigin="anonymous"></script>
    <script
      src={deploymentPath + "assets/flatpickr/flatpickr.min.js"}
      integrity="sha384-5JqMv4L/Xa0hfvtF06qboNdhvuYXUku9ZrhZh3bSk8VXF0A/RuSLHpLsSV9Zqhl6"
      crossorigin="anonymous"></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // Tom Select：单选，带搜索和确定按钮
        new TomSelect("#country", {
          plugins: ["clear_button"],
          sortField: { field: "text", direction: "asc" }
        });

        // Tom 选择：可移除标签的多选（输入以添加新标签）
        new TomSelect("#post-tags", {
          plugins: ["remove_button"],
          create: true,
          persist: false
        });

        // Tom Select：远程数据，就是那种给一个背后有几千行数据的表绑定下拉框的写法。
        // 永远只加载匹配的那一页数据。
        const PAGE_SIZE = 12;
        const FIRST_NAMES = [
          "奥利维亚", "利亚姆", "艾玛", "诺亚", "艾娃", "伊桑", "索菲亚", "卢卡斯",
          "米娅", "马特奥", "艾拉", "阿尔琼", "诺拉", "雨果", "由纪", "阿玛拉",
          "埃琳娜", "奥马尔", "芙蕾雅", "迭戈", "莱拉", "乔纳斯", "普里娅", "马雷克"
        ];
        const TEAMS = ["前端", "后端", "设计"];
        // 代表数据库表的占位符。
        const REVIEWERS = FIRST_NAMES.flatMap((first, index) =>
          ["Bennett", "Carter", "Dawson"].map((last, offset) => ({
            id: index * 3 + offset + 1,
            name: `${first} ${last}`,
            team: TEAMS[(index + offset) % TEAMS.length]
          }))
        );

        // 这是一个真实接口的替身（模拟实现）。要上线对接真实接口的话，把整个函数体换成：
        //   return fetch(url, { signal }).then((response) => response.json())
        // { results, next } 这种响应结构正是下面这个加载器所期望的
        // —— 也是 Select2 用户在 `ajax.processResults` 里返回的同一种结构。
        function fetchReviewers(url, signal) {
          const params = new URLSearchParams(url.slice(url.indexOf("?") + 1));
          const query = (params.get("q") || "").toLowerCase();
          const page = Number(params.get("page") || 1);

          return new Promise((resolve, reject) => {
            const timer = setTimeout(() => {
              const matches = REVIEWERS.filter((person) =>
                `${person.name} ${person.team}`.toLowerCase().includes(query)
              );
              const start = (page - 1) * PAGE_SIZE;
              const hasMore = start + PAGE_SIZE < matches.length;
              resolve({
                results: matches.slice(start, start + PAGE_SIZE),
                next: hasMore ?
                  `/api/reviewers?q=${encodeURIComponent(query)}&page=${page + 1}` :
                  null
              });
            }, 400);

            signal.addEventListener("abort", () => {
              clearTimeout(timer);
              reject(new DOMException("Aborted", "AbortError"));
            });
          });
        }

        let inFlight = null;

        new TomSelect("#reviewer", {
          valueField: "id",
          labelField: "name",
          searchField: ["name", "team"],
          placeholder: "Type to search 72 people…",
          preload: "focus",
          // Tom Select 为你自动处理 `load`，无需手动设置计时器。
          loadThrottle: 300,
          // 下拉菜单滚动到底部时，下一组的页面。
          plugins: ["virtual_scroll"],
          firstUrl: (query) => `/api/reviewers?q=${encodeURIComponent(query)}&page=1`,
          // Tom Select 调用 `load` 时会把实例作为 `this` 传进来；virtual_scroll 插件
          // 就是通过这种方式把 getUrl() 和 setNextUrl() 交到手里的。
          /* eslint-disable unicorn/no-this-outside-of-class */
          async load(query, callback) {
            // 把已经在请求中的那个取消掉，
            // 免得搜 "an" 的慢响应在搜 "anna" 的快响应之后才回来。
            if (inFlight) {
              inFlight.abort();
            }
            inFlight = new AbortController();

            try {
              const json = await fetchReviewers(this.getUrl(query), inFlight.signal);
              if (json.next) {
                this.setNextUrl(query, json.next);
              }
              callback(json.results);
            } catch (error) {
              // 被中止的那个请求已经被更新的请求取代了——让新的那个去处理下拉框的结果，
              // 这里就别去清空它了。
              if (error.name !== "AbortError") {
                callback();
              }
            }
          },
          /* eslint-enable unicorn/no-this-outside-of-class */
          render: {
            option: (data, escape) =>
              `<div class="d-flex justify-content-between align-items-center">
                 <span>${escape(data.name)}</span>
                 <span class="badge text-bg-secondary">${escape(data.team)}</span>
               </div>`,
            loading_more: () =>
              '<div class="p-2 text-body-secondary small">加载更多...</div>',
            no_more_results: () =>
              '<div class="p-2 text-body-secondary small">没有更多结果了</div>'
          }
        });

        // Flatpickr: date picker
        flatpickr("#delivery-date", {"locale": "zh",
          dateFormat: "Y-m-d"
        });

        // Flatpickr: date & time picker
        flatpickr("#meeting-start", {"locale": "zh",
          enableTime: true,
          dateFormat: "Y-m-d H:i"
        });

        // Flatpickr: range picker
        flatpickr("#report-period", {"locale": "zh",
          mode: "range",
          dateFormat: "Y-m-d"
        });

        // Flatpickr: time-only picker
        flatpickr("#reminder-time", {"locale": "zh",
          enableTime: true,
          noCalendar: true,
          dateFormat: "H:i",
          time_24hr: true
        });
      });
    </script>
  </body>
</html>

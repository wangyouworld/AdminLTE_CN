---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | 表单验证"
const path = "../../../dist"
const mainPage = "forms"
const page = "validation";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head title={title} path={path} />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">表单验证</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">首页</a></li>
                    <li class="breadcrumb-item"><a href="#">表单</a></li>
                    <li class="breadcrumb-item active" aria-current="page">验证</li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="row g-4">
              <div class="col-12">
                <div class="callout callout-info">
                  基于
                  <a
                    href="https://getbootstrap.com/docs/5.3/forms/validation/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="callout-link"
                  >Bootstrap 的原生表单验证功能</a>
                  ——提交每个表单以查看反馈。相关脚本位于本页面底部。
                </div>
              </div>

              <!-- Custom validation -->
              <div class="col-lg-6">
                <div class="card card-info card-outline mb-4">
                  <div class="card-header">
                    <div class="card-title">自定义验证</div>
                  </div>
                  <form class="needs-validation" novalidate>
                    <div class="card-body">
                      <div class="row g-3">
                        <div class="col-md-6">
                          <label for="validationCustom01" class="form-label">姓</label>
                          <input
                            type="text"
                            class="form-control"
                            id="validationCustom01"
                            value="张"
                            required
                          />
                          <div class="valid-feedback">不错！</div>
                        </div>
                        <div class="col-md-6">
                          <label for="validationCustom02" class="form-label">名</label>
                          <input
                            type="text"
                            class="form-control"
                            id="validationCustom02"
                            value="三"
                            required
                          />
                          <div class="valid-feedback">不错！</div>
                        </div>
                        <div class="col-md-6">
                          <label for="validationCustomUsername" class="form-label">用户名</label>
                          <div class="input-group has-validation">
                            <span class="input-group-text" id="inputGroupPrepend">@</span>
                            <input
                              type="text"
                              class="form-control"
                              id="validationCustomUsername"
                              aria-describedby="inputGroupPrepend"
                              required
                            />
                            <div class="invalid-feedback">请选择用户名。</div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <label for="validationCustom03" class="form-label">城市</label>
                          <input
                            type="text"
                            class="form-control"
                            id="validationCustom03"
                            required
                          />
                          <div class="invalid-feedback">请提供一个有效的城市。</div>
                        </div>
                        <div class="col-md-6">
                          <label for="validationCustom04" class="form-label">地区</label>
                          <select
                            class="form-select"
                            id="validationCustom04"
                            required
                          >
                            <option selected disabled value="">选择&hellip;</option>
                            <option>加利福尼亚</option>
                            <option>华盛顿</option>
                            <option>田纳西州</option>
                          </select>
                          <div class="invalid-feedback">请选择有效的地区。</div>
                        </div>
                        <div class="col-md-6">
                          <label for="validationCustom05" class="form-label">邮编</label>
                          <input
                            type="text"
                            class="form-control"
                            id="validationCustom05"
                            required
                          />
                          <div class="invalid-feedback">请提供一个有效的邮编。</div>
                        </div>
                        <div class="col-12">
                          <div class="form-check">
                            <input
                              class="form-check-input"
                              type="checkbox"
                              value=""
                              id="invalidCheck"
                              required
                            />
                            <label class="form-check-label" for="invalidCheck">
                              同意条款和条件
                            </label>
                            <div class="invalid-feedback">提交前你必须同意。</div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="card-footer">
                      <button class="btn btn-info" type="submit">提交表单</button>
                    </div>
                  </form>
                </div>
              </div>

              <!-- Browser-default validation + tooltips -->
              <div class="col-lg-6">
                <div class="card card-success card-outline mb-4">
                  <div class="card-header">
                    <div class="card-title">浏览器默认设置 &amp; 提示信息</div>
                  </div>
                  <div class="card-body">
                    <p class="text-secondary small">
                      对于原生浏览器验证反馈，
                      请省略 <code>novalidate</code> 和 <code>.needs-validation</code>类。
                    </p>
                    <form>
                      <div class="mb-3">
                        <label class="form-label" for="defaultEmail">邮箱</label>
                        <input
                          type="email"
                          class="form-control"
                          id="defaultEmail"
                          required
                        />
                      </div>
                      <div class="mb-3">
                        <label class="form-label" for="defaultUrl">URL</label>
                        <input
                          type="url"
                          class="form-control"
                          id="defaultUrl"
                          required
                        />
                      </div>
                      <button class="btn btn-success" type="submit">提交（浏览器默认）</button>
                    </form>

                    <hr class="my-4" />

                    <p class="text-secondary small">
                      使用 <code>.needs-validation-tooltip</code> 替
                      换为 <code>.needs-validation</code>，即可把行内验证反馈改为浮动提示框样式。
                    </p>
                    <form class="needs-validation-tooltip position-relative" novalidate>
                      <div class="row g-3">
                        <div class="col-md-6">
                          <label for="vt-first" class="form-label">姓</label>
                          <input
                            type="text"
                            class="form-control"
                            id="vt-first"
                            value="Jane"
                            required
                          />
                          <div class="valid-tooltip">不错！</div>
                        </div>
                        <div class="col-md-6">
                          <label for="vt-username" class="form-label">用户名</label>
                          <input
                            type="text"
                            class="form-control"
                            id="vt-username"
                            required
                          />
                          <div class="invalid-tooltip">请选择用户名。</div>
                        </div>
                        <div class="col-12">
                          <button class="btn btn-success" type="submit">提交（tooltip）</button>
                        </div>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
    <script is:inline>
      // 启用 Bootstrap 风格的表单验证，适用于标记为 .needs-validation
      // 或 .needs-validation-tooltip 的表单。如果任何字段无效，将阻止提交。
      ;(() => {
        "use strict"
        const selector = ".needs-validation, .needs-validation-tooltip"
        for (const form of document.querySelectorAll(selector)) {
          form.addEventListener(
            "submit",
            (event) => {
              if (!form.checkValidity()) {
                event.preventDefault()
                event.stopPropagation()
              }
              form.classList.add("was-validated")
            },
            false
          )
        }
      })()
    </script>
  </body>
</html>

    <!--begin::Script-->
    <Scripts path={path} />
    <script is:inline define:vars={{ paletteClasses }}>
      // 主题自定义：用一个控制器统一管这三个区域。把选好的背景 + 颜色模式
      // 应用到本页面上，并打印出对应的标记。
      // 页面内的演示脚本 —— 不属于 adminlte.js 的一部分。
      const option = bg => `<option value="${bg}" class="text-${bg.replace(/^(text-bg-|bg-gradient-)/, "")}">${bg}</option>`

      document.addEventListener("DOMContentLoaded", () => {
        // Bootstrap 的背景工具类（全部来自 adminlte.css）……
        const bootstrapBg = [
          "bg-primary", "bg-primary-subtle",
          "bg-secondary", "bg-secondary-subtle",
          "bg-success", "bg-success-subtle",
          "bg-danger", "bg-danger-subtle",
          "bg-warning", "bg-warning-subtle",
          "bg-info", "bg-info-subtle",
          "bg-light", "bg-light-subtle",
          "bg-dark", "bg-dark-subtle",
          "bg-body-secondary", "bg-body-tertiary", "bg-body",
          "bg-black", "bg-white", "bg-transparent"
        ]
        // … plus the extended palette (opt-in css/adminlte-colors.css), as
        // `.text-bg-*` so the contrast text comes with the background, and its
        // `.bg-gradient-*` variants.
        const paletteGradient = paletteClasses.map(c => c.replace("text-bg-", "bg-gradient-"))
        const allBg = [...bootstrapBg, ...paletteClasses, ...paletteGradient]

        const regions = [
          { element: ".app-sidebar", modes: "#sidebar-color-modes", colors: "#sidebar-color", code: "#sidebar-color-code", open: '&lt;aside class="app-sidebar', close: '&gt;...&lt;/aside&gt;' },
          { element: ".app-header", modes: "#navbar-color-modes", colors: "#navbar-color", code: "#navbar-color-code", open: '&lt;nav class="app-header navbar navbar-expand', close: '&gt;...&lt;/nav&gt;' },
          { element: ".app-footer", modes: "#footer-color-modes", colors: "#footer-color", code: "#footer-color-code", open: '&lt;footer class="app-footer', close: '&gt;...&lt;/footer&gt;' }
        ]

        const controllers = {}
        const presetButtons = document.querySelectorAll("#theme-presets [data-preset-sidebar]")
        const markPresets = () => {
          const sidebar = controllers[".app-sidebar"]
          const header = controllers[".app-header"]
          if (!sidebar || !header) {
            return
          }
          for (const button of presetButtons) {
            const matches =
              button.getAttribute("data-preset-sidebar") === sidebar.get().bg &&
              button.getAttribute("data-preset-sidebar-theme") === sidebar.get().mode &&
              button.getAttribute("data-preset-header") === header.get().bg &&
              button.getAttribute("data-preset-header-theme") === header.get().mode
            button.setAttribute("aria-pressed", String(matches))
          }
        }

        for (const region of regions) {
          const element = document.querySelector(region.element)
          const modeSelect = document.querySelector(region.modes)
          const colorSelect = document.querySelector(region.colors)
          const code = document.querySelector(region.code)
          if (!element || !modeSelect || !colorSelect || !code) {
            continue
          }

          colorSelect.innerHTML =
            '<option value="">---选择---</option>' +
            `<optgroup label="Bootstrap">${bootstrapBg.map(option).join("")}</optgroup>` +
            `<optgroup label="Extended palette (adminlte-colors.css)">${paletteClasses.map(option).join("")}</optgroup>` +
            `<optgroup label="Extended palette · gradient">${paletteGradient.map(option).join("")}</optgroup>`

          // 从页面当前显示的内容开始。
          let mode = element.getAttribute("data-bs-theme") || ""
          let bg = [...element.classList].find(c => allBg.includes(c)) || ""
          modeSelect.value = mode
          colorSelect.value = bg

          const render = () => {
            if (mode) {
              element.setAttribute("data-bs-theme", mode)
            } else {
              element.removeAttribute("data-bs-theme")
            }
            const classes = [bg].filter(Boolean).join(" ")
            const theme = mode ? ` data-bs-theme="${mode}"` : ""
            code.innerHTML = `<pre><code class="language-html">${region.open}${classes ? " " + classes : ""}"${theme}${region.close}</code></pre>`
            markPresets()
          }

          const applyBg = value => {
            bg = value
            element.classList.remove(...allBg)
            if (bg) {
              element.classList.add(bg)
            }
          }

          controllers[region.element] = {
            get: () => ({ bg, mode }),
            set: (nextBg, nextMode) => {
              applyBg(nextBg)
              mode = nextMode
              colorSelect.value = bg
              modeSelect.value = mode
              render()
            }
          }

          modeSelect.addEventListener("input", event => {
            mode = event.target.value
            render()
          })

          colorSelect.addEventListener("input", event => {
            applyBg(event.target.value)
            // 每个调色板颜色都是为白色文字设计的：当用户挑了一个颜色、
            // 但还没选颜色模式时，就把模式默认成深色。
            if ((bg.startsWith("text-bg-") || bg.startsWith("bg-gradient-")) && !mode) {
              mode = "dark"
              modeSelect.value = "dark"
            }
            render()
          })

          render()
        }

        // 预设：一次点击就搞定侧边栏 + 导航栏；页脚保持原样不动。
        for (const button of presetButtons) {
          button.addEventListener("click", () => {
            controllers[".app-sidebar"]?.set(button.getAttribute("data-preset-sidebar"), button.getAttribute("data-preset-sidebar-theme"))
            controllers[".app-header"]?.set(button.getAttribute("data-preset-header"), button.getAttribute("data-preset-header-theme"))
          })
        }
        markPresets()
      })
    </script>
    <!--end::Script-->
  </body><!--end::Body-->
</html>

                      <div class="col-12 col-md-4">
                        <div class="progress" role="progressbar" aria-label="Example progress" aria-valuenow="62" aria-valuemin="0" aria-valuemax="100">
                          <div class="progress-bar" style="width: 62%">62%</div>
                        </div>
                      </div>
                    </div>
                    <!--end::Row(Preview)-->
                  </div>
                  <!--end::Card Body-->
                  <!--begin::Card Footer-->
                  <div class="card-footer">
                    需要 <code>css/adminlte-colors.css</code>（或者
                    <code>css/adminlte-colors-v3.css</code>）—— 详见
                    <a href={deploymentPath + "docs/colors.html"} class="link-primary">颜色</a>。
                  </div>
                  <!--end::Card Footer-->
                </div>
                <!--end::Card(Primary colour)-->
              </div>
              <!--end::Col-->
            </div>
            <!--end::Row-->
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content-->
      </main>
      <!--end::App Main-->
      <Footer />
    </div>
    <!--end::App Wrapper-->
    <!--begin::Script-->
    <Scripts path={path} />
    <script is:inline define:vars={{ paletteSetsJson }}>
      // 主题自定义：用一个控制器统一管这三个区域。把选好的背景 + 颜色模式
      // 应用到本页面上，并打印出对应的标记。
      // 页面内的演示脚本 —— 不属于 adminlte.js 的一部分。
      const option = bg => `<option value="${bg}" class="text-${bg.replace(/^(text-bg-|bg-gradient-)/, "")}">${bg}</option>`
      const gradients = set => set.classes.map(c => c.replace("text-bg-", "bg-gradient-"))

      document.addEventListener("DOMContentLoaded", () => {
        // Bootstrap 的背景工具类（全部来自 adminlte.css）……
        const bootstrapBg = [
          "bg-primary", "bg-primary-subtle",
          "bg-secondary", "bg-secondary-subtle",
          "bg-success", "bg-success-subtle",
          "bg-danger", "bg-danger-subtle",
          "bg-warning", "bg-warning-subtle",
          "bg-info", "bg-info-subtle",
          "bg-light", "bg-light-subtle",
          "bg-dark", "bg-dark-subtle",
          "bg-body-secondary", "bg-body-tertiary", "bg-body",
          "bg-black", "bg-white", "bg-transparent"
        ]
        // ……再加上扩展调色板（按需引入 css/adminlte-colors.css，或者 AdminLTE 3 原版的
        // adminlte-colors-v3.css —— 两者只能选一个），以 `.text-bg-*` 的形式使用，
        // 这样对比文字会跟着背景一起带上；
        // 还有它的 `.bg-gradient-*` 变体。
        const stylesheet = document.getElementById("palette-stylesheet")
        const contrastToggle = document.querySelector("#contrast-aa")
        let activeSet = paletteSetsJson[0]
        let aaContrast = false
        // 背景类的自动文本颜色，处于开启模式下
        const textOf = bg => (aaContrast ? activeSet.textAA : activeSet.text)[bg.replace("bg-gradient-", "text-bg-")] || "white"
        // 列出任何调色板可能加到元素上的所有类 —— 这样切换调色板时才能清理干净。
        const allBg = [...bootstrapBg, ...paletteSetsJson.flatMap(set => [...set.classes, ...gradients(set)])]
        const availableBg = () => [...bootstrapBg, ...activeSet.classes, ...gradients(activeSet)]

        const regions = [
          { element: ".app-sidebar", modes: "#sidebar-color-modes", colors: "#sidebar-color", code: "#sidebar-color-code", open: '&lt;aside class="app-sidebar', close: '&gt;...&lt;/aside&gt;' },
          { element: ".app-header", modes: "#navbar-color-modes", colors: "#navbar-color", code: "#navbar-color-code", open: '&lt;nav class="app-header navbar navbar-expand', close: '&gt;...&lt;/nav&gt;' },
          { element: ".app-footer", modes: "#footer-color-modes", colors: "#footer-color", code: "#footer-color-code", open: '&lt;footer class="app-footer', close: '&gt;...&lt;/footer&gt;' }
        ]

        const controllers = {}
        const presetButtons = document.querySelectorAll(".theme-presets [data-preset-sidebar]")

        // <html> 上的 `data-lte-primary`：让 Bootstrap 那些 `primary` 组件
        //（按钮、链接、分页、复选框、进度条）采用某个调色板颜色。
        // 值为空 = 不加属性 = Bootstrap 原本的蓝色。
        const primary = (() => {
          const select = document.querySelector("#primary-color")
          const code = document.querySelector("#primary-color-code")
          if (!select || !code) {
            return null
          }
          let value = ""
          const render = () => {
            if (value) {
              document.documentElement.setAttribute("data-lte-primary", value)
            } else {
              document.documentElement.removeAttribute("data-lte-primary")
            }
            select.value = value
            code.innerHTML = `<pre><code class="language-html">&lt;html lang="en"${value ? ` data-lte-primary="${value}"` : ""}&gt;</code></pre>`
            markPresets()
          }
          const renderOptions = () => {
            select.innerHTML =
              '<option value="">---选择--- (Bootstrap blue)</option>' +
              `<optgroup label="Extended palette (${activeSet.file})">${activeSet.primaries.map(name => `<option value="${name}" class="text-${name}">${name}</option>`).join("")}</optgroup>`
          }
          renderOptions()
          select.addEventListener("input", event => {
            value = event.target.value
            render()
          })
          return {
            get: () => value,
            set: next => {
              value = activeSet.primaries.includes(next) ? next : ""
              render()
            },
            refresh: () => {
              renderOptions()
              if (value && !activeSet.primaries.includes(value)) {
                value = ""
              }
              render()
            }
          }
        })()
        const markPresets = () => {
          const sidebar = controllers[".app-sidebar"]
          const header = controllers[".app-header"]
          if (!sidebar || !header) {
            return
          }
          for (const button of presetButtons) {
            const matches =
              (primary ? button.getAttribute("data-preset-primary") === (primary.get() || "primary") : true) &&
              button.getAttribute("data-preset-sidebar") === sidebar.get().bg &&
              button.getAttribute("data-preset-sidebar-theme") === sidebar.get().mode &&
              button.getAttribute("data-preset-header") === header.get().bg &&
              button.getAttribute("data-preset-header-theme") === header.get().mode
            button.setAttribute("aria-pressed", String(matches))
          }
        }

        for (const region of regions) {
          const element = document.querySelector(region.element)
          const modeSelect = document.querySelector(region.modes)
          const colorSelect = document.querySelector(region.colors)
          const code = document.querySelector(region.code)
          if (!element || !modeSelect || !colorSelect || !code) {
            continue
          }

          const renderOptions = () => {
            colorSelect.innerHTML =
              '<option value="">---选择---</option>' +
              `<optgroup label="Bootstrap">${bootstrapBg.map(option).join("")}</optgroup>` +
              `<optgroup label="Extended palette (${activeSet.file})">${activeSet.classes.map(option).join("")}</optgroup>` +
              `<optgroup label="Extended palette · gradient">${gradients(activeSet).map(option).join("")}</optgroup>`
          }
          renderOptions()

          // 从页面当前显示的内容开始。
          let mode = element.getAttribute("data-bs-theme") || ""
          let bg = [...element.classList].find(c => allBg.includes(c)) || ""
          modeSelect.value = mode
          colorSelect.value = bg

          const render = () => {
            if (mode) {
              element.setAttribute("data-bs-theme", mode)
            } else {
              element.removeAttribute("data-bs-theme")
            }
            const classes = [bg].filter(Boolean).join(" ")
            const theme = mode ? ` data-bs-theme="${mode}"` : ""
            code.innerHTML = `<pre><code class="language-html">${region.open}${classes ? " " + classes : ""}"${theme}${region.close}</code></pre>`
            markPresets()
          }

          const applyBg = value => {
            bg = value
            element.classList.remove(...allBg)
            if (bg) {
              element.classList.add(bg)
            }
          }

          controllers[region.element] = {
            get: () => ({ bg, mode }),
            set: (nextBg, nextMode) => {
              applyBg(nextBg)
              mode = nextMode
              colorSelect.value = bg
              modeSelect.value = mode
              render()
            },
            // 切换调色板之后：重建选项；如果新调色板里没有某个颜色，
            // 就回退到该区域朴素的背景。
            refresh: () => {
              renderOptions()
              if (bg && !availableBg().includes(bg)) {
                applyBg("")
              }
              colorSelect.value = bg
              render()
            }
          }

          modeSelect.addEventListener("input", event => {
            mode = event.target.value
            render()
          })

          colorSelect.addEventListener("input", event => {
            applyBg(event.target.value)
            // 当用户还没选颜色模式时，调色板的颜色会搭配与其文字颜色相匹配的模式
            //（配白色文字的颜色就用深色模式）。
            if ((bg.startsWith("text-bg-") || bg.startsWith("bg-gradient-")) && !mode) {
              mode = textOf(bg) === "white" ? "dark" : "light"
              modeSelect.value = mode
            }
            render()
          })

          render()
        }

        // 预设：一次点击就搞定侧边栏 + 导航栏；页脚保持原样不动。
        for (const button of presetButtons) {
          button.addEventListener("click", () => {
            controllers[".app-sidebar"]?.set(button.getAttribute("data-preset-sidebar"), button.getAttribute("data-preset-sidebar-theme"))
            controllers[".app-header"]?.set(button.getAttribute("data-preset-header"), button.getAttribute("data-preset-header-theme"))
            primary?.set(button.getAttribute("data-preset-primary"))
          })
        }

        // WCAG AA 文本：`data-lte-contrast="aa"` 位于 <html> 元素上。
        // 该区域的颜色会变为深色文本，因此需要启用浅色模式，以便其链接能够正确显示。
        contrastToggle?.addEventListener("change", () => {
          aaContrast = contrastToggle.checked
          if (aaContrast) {
            document.documentElement.setAttribute("data-lte-contrast", "aa")
          } else {
            document.documentElement.removeAttribute("data-lte-contrast")
          }
          for (const controller of Object.values(controllers)) {
            const { bg } = controller.get()
            if (bg && (bg.startsWith("text-bg-") || bg.startsWith("bg-gradient-"))) {
              controller.set(bg, textOf(bg) === "white" ? "dark" : "light")
            }
          }
        })

        // 调色板切换：替换样式表，显示对应调色板的预设，重建取色器。
        for (const button of document.querySelectorAll("[data-palette-switch]")) {
          button.addEventListener("click", () => {
            activeSet = paletteSetsJson.find(set => set.key === button.getAttribute("data-palette-switch")) || paletteSetsJson[0]
            stylesheet.href = stylesheet.getAttribute("data-css-dir") + activeSet.file
            for (const b of document.querySelectorAll("[data-palette-switch]")) {
              const on = b === button
              b.classList.toggle("active", on)
              b.setAttribute("aria-pressed", String(on))
            }
            for (const el of document.querySelectorAll("[data-palette-set]")) {
              el.hidden = el.getAttribute("data-palette-set") !== activeSet.key
            }
            for (const c of Object.values(controllers)) {
              c.refresh()
            }
            primary?.refresh()
          })
        }
        primary?.refresh()
        markPresets()
      })
    </script>
    <!--end::Script-->
  </body><!--end::Body-->
</html>

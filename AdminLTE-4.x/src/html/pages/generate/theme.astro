---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Scripts from "@components/_scripts.astro"
import SkinPreview from "@components/_skin-preview.astro"
import { convertPathToHtml } from "../../../utils/index.js"
import { palette, paletteV3, skinGroups, skinGroupsV3, skins, skinsV3 } from "../../../utils/palette.mjs"

const title = "AdminLTE 4 | 自定义主题"
// 扩展调色板（dist/css/adminlte-colors.css）是需要主动引入的；本页面加载了它，
// 这样取色器也能提供那些颜色。皮肤用的是 `.text-bg-*`，所以配套的对比色文字
// 会一起带上——详见 docs/colors.html。
const paletteClasses = palette.map(c => `text-bg-${c.name}`)
// AdminLTE 3 的原版颜色（adminlte-colors-v3.css）是那个备选样式表；
// 两者定义的是同一批类名，所以页面一次只加载一个。
const paletteSets = [
  { key: "designed" as const, label: "设计配色方案 (4.4)", file: "adminlte-colors.css", groups: skinGroups, skins, classes: paletteClasses, text: Object.fromEntries(palette.map(c => [`text-bg-${c.name}`, c.textColor])) },
  { key: "v3" as const, label: "AdminLTE 3 原版", file: "adminlte-colors-v3.css", groups: skinGroupsV3, skins: skinsV3, classes: paletteV3.map(c => `text-bg-${c.name}`), text: Object.fromEntries(paletteV3.map(c => [`text-bg-${c.name}`, c.textColor])) }
]
// 每个样式表能提供的 `data-lte-primary` 取值（#6107）
const primaryChoices = {
  designed: palette.map(c => c.name),
  v3: paletteV3.map(c => c.name)
}
// `data-lte-contrast="aa"` 文本颜色，以及它会改变多少种颜色（#6110）
const paletteTextAA = {
  designed: Object.fromEntries(palette.map(c => [`text-bg-${c.name}`, c.textColorAA])),
  v3: Object.fromEntries(paletteV3.map(c => [`text-bg-${c.name}`, c.textColorAA]))
}
const aaFlipCount = {
  designed: palette.filter(c => c.textColor !== c.textColorAA).length,
  v3: paletteV3.filter(c => c.textColor !== c.textColorAA).length
}
const paletteSetsJson = paletteSets.map(({ key, file, classes, text }) => ({
  key, file, classes, text, textAA: paletteTextAA[key], aaFlips: aaFlipCount[key], primaries: primaryChoices[key]
}))
const path = "../../../dist"
const htmlPath = convertPathToHtml(path);

// 智能路径解析：根据目录深度计算相对路径
const pathname = Astro.url.pathname;
const pathSegments = pathname.split('/').filter(segment => segment !== '');
const depth = pathSegments.length > 0 ? pathSegments.length - 1 : 0;
const deploymentPath = depth === 0 ? './' : '../'.repeat(depth);
---


          <!--end::Container-->
        </div>
        <!--end::App Content-->
      </main>
      <!--end::App Main-->
      <Footer />
    </div>
    <!--end::App Wrapper-->
    <!--begin::Script-->
    <Scripts path={path} />

    <!-- 可选脚本 -->

    <!-- sortablejs -->
    <script
      src={deploymentPath + "assets/sortablejs/Sortable.min.js"}
      crossorigin="anonymous"></script>

    <!-- sortablejs -->
    <script is:inline>
new Sortable(document.querySelector('.connectedSortable'), {
  group: 'shared',
  handle: '.card-header'
})

const cardHeaders = document.querySelectorAll(
  '.connectedSortable .card-header'
)
cardHeaders.forEach(cardHeader => {
  cardHeader.style.cursor = 'move'
})
    </script>

    <!-- Chart.js + AdminLTE 图表主题 -->
    <ChartJs />

    <!-- Chart.js -->
    <script is:inline>
// 请注意！！！不要使用任何 javascript
// 它们是演示用的
// ++++++++++++++++++++++++++++++++++++++++++

const { areaFill } = globalThis.lteChartTheme

new Chart(document.querySelector('#revenue-chart'), {
  type: 'line',
  data: {
    labels: ["23年1月", "23年2月", "23年3月", "23年4月", "23年5月", "23年6月", "23年7月"],
    datasets: [
      {
        label: '数字产品',
        data: [28, 48, 40, 19, 86, 27, 90],
        borderColor: '#0d6efd',
        backgroundColor: areaFill('#0d6efd'),
        pointBackgroundColor: '#0d6efd',
        fill: true,
        tension: 0.4
      },
      {
        label: '电子产品',
        data: [65, 59, 80, 81, 56, 55, 40],
        borderColor: '#20c997',
        backgroundColor: areaFill('#20c997'),
        pointBackgroundColor: '#20c997',
        fill: true,
        tension: 0.4
      }
    ]
  },
  options: {
    plugins: {
      legend: {
        display: false
      },
      tooltip: {
        callbacks: {
          title: ([item]) => `2023 年 ${new Date(2023, item.dataIndex).toLocaleString('zh-CN', { month: 'long' })}`
        }
      }
    },
    scales: {
      y: {
        beginAtZero: true
      }
    }
  }
})
    </script>

    <!-- jsvectormap -->
    <script
      src={deploymentPath + "assets/jsvectormap/jsvectormap.min.js"}
      integrity="sha256-yjoBT8ZtgknE2gcA8yvWExzw8LsIAfj6/r/XAw889Qw="
      crossorigin="anonymous"></script>
    <script
      src={deploymentPath + "assets/jsvectormap/world.js"}
      integrity="sha256-ehebNYsyxFr2g6Mn9B7SaOzDfLtdoxEU1A67I7Laiyc="
      crossorigin="anonymous"></script>

    <!-- jsvectormap -->
    <script is:inline>
      // 世界地图 由 VectorMap
      new jsVectorMap({
        selector: '#world-map',
        map: 'world'
      });

      // 迷你图
      const sparkline = (selector, data) =>
        new Chart(document.querySelector(selector), {
          type: 'line',
          data: {
            labels: data.map((value, index) => index + 1),
            datasets: [
              {
                data,
                borderColor: '#DCE6EC',
                backgroundColor: 'rgba(220, 230, 236, 0.3)',
                pointBackgroundColor: '#DCE6EC',
                fill: true
              }
            ]
          },
          options: {
            layout: { padding: { top: 2 } },
            plugins: {
              legend: { display: false },

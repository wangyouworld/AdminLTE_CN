                <!-- /.direct-chat -->
              </div>
              <!-- /.Start col -->

              <!-- Start col -->
              <div class="col-lg-5 connectedSortable">
                <div
                  class="card text-white bg-primary bg-gradient border-primary mb-4"
                >
                  <div class="card-header border-0">
                    <h3 class="card-title">销售额</h3>
                    <div class="card-tools">
                      <button
                        type="button"
                        class="btn btn-primary btn-sm"
                        data-lte-toggle="card-collapse"
                        aria-label="折叠卡片"
                      >
                        <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                        <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                      </button>
                    </div>
                  </div>
                  <div class="card-body">
                    <div id="world-map" style="height: 220px"></div>
                  </div>
                  <div class="card-footer border-0">
                    <!--begin::Row-->
                    <div class="row">
                      <div class="col-4 text-center">
                        <div class="position-relative" style="height: 50px">
                          <canvas id="sparkline-1" role="img" aria-label="访客趋势"></canvas>
                        </div>
                        <div class="text-white">访客</div>
                      </div>
                      <div class="col-4 text-center">
                        <div class="position-relative" style="height: 50px">
                          <canvas id="sparkline-2" role="img" aria-label="在线趋势"></canvas>
                        </div>
                        <div class="text-white">在线</div>
                      </div>
                      <div class="col-4 text-center">
                        <div class="position-relative" style="height: 50px">
                          <canvas id="sparkline-3" role="img" aria-label="销售趋势"></canvas>

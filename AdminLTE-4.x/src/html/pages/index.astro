                        />
                        <!-- /.direct-chat-img -->
                        <div class="direct-chat-text">
                          使用 AdminLTE 开发强大的应用！想加入吗？
                        </div>
                        <!-- /.direct-chat-text -->
                      </div>
                      <!-- /.direct-chat-msg -->

                      <!-- Message to the end -->
                      <div class="direct-chat-msg end">
                        <div class="direct-chat-infos clearfix">
                          <span class="direct-chat-name float-end">
                            莎拉·布拉洛克
                          </span>
                          <span class="direct-chat-timestamp float-start">
                            1月23日 下午6:10
                          </span>
                        </div>
                        <!-- /.direct-chat-infos -->
                        <img
                          class="direct-chat-img"
                          src={deploymentPath + "assets/img/user3-128x128.jpg"}
                          alt="用户头像"
                        />
                        <!-- /.direct-chat-img -->
                        <div class="direct-chat-text">是的，我想。</div>
                        <!-- /.direct-chat-text -->
                      </div>
                      <!-- /.direct-chat-msg -->
                    </div>
                    <!-- /.direct-chat-messages-->

                    <!-- Contacts are loaded here -->
                    <div class="direct-chat-contacts">
                      <ul class="contacts-list">
                        <li>
                          <a href="#">
                            <img
                              class="contacts-list-img"
                              src={deploymentPath + "assets/img/user1-128x128.jpg"}

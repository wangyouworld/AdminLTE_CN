                            />

                            <div class="contacts-list-info">
                              <span class="contacts-list-name">
                                Count Dracula
                                <small class="contacts-list-date float-end">
                                  2023-2-28
                                </small>
                              </span>
                              <span class="contacts-list-msg">
                                你最近怎么样？我是……
                              </span>
                            </div>
                            <!-- /.contacts-list-info -->
                          </a>
                        </li>
                        <!-- 聊天结束 -->
                        <li>
                          <a href="#">
                            <img
                              class="contacts-list-img"
                              src={deploymentPath + "assets/img/user7-128x128.jpg"}
                              alt="用户头像"
                            />

                            <div class="contacts-list-info">
                              <span class="contacts-list-name">
                                Sarah Doe
                                <small class="contacts-list-date float-end">
                                  2023-2-23
                                </small>
                              </span>
                              <span class="contacts-list-msg">
                                我会等……
                              </span>
                            </div>
                            <!-- /.contacts-list-info -->
                          </a>
                        </li>
                        <!-- 聊天结束 -->
                        <li>
                          <a href="#">
                            <img
                              class="contacts-list-img"
                              src={deploymentPath + "assets/img/user3-128x128.jpg"}
                              alt="用户头像"
                            />

                            <div class="contacts-list-info">
                              <span class="contacts-list-name">
                                Nadia Jolie
                                <small class="contacts-list-date float-end">
                                  2023-2-20
                                </small>
                              </span>
                              <span class="contacts-list-msg">
                                我会打电话给你……
                              </span>
                            </div>
                            <!-- /.contacts-list-info -->
                          </a>
                        </li>
                        <!-- 聊天结束 -->
                        <li>
                          <a href="#">
                            <img
                              class="contacts-list-img"
                              src={deploymentPath + "assets/img/user5-128x128.jpg"}
                              alt="用户头像"
                            />

                            <div class="contacts-list-info">
                              <span class="contacts-list-name">
                                Nora S. Vans
                                <small class="contacts-list-date float-end">
                                  2023-2-10
                                </small>
                              </span>
                              <span class="contacts-list-msg">
                                你的新……
                              </span>
                            </div>
                            <!-- /.contacts-list-info -->
                          </a>
                        </li>
                        <!-- 聊天结束 -->
                        <li>
                          <a href="#">
                            <img
                              class="contacts-list-img"
                              src={deploymentPath + "assets/img/user6-128x128.jpg"}
                              alt="用户头像"
                            />

                            <div class="contacts-list-info">
                              <span class="contacts-list-name">
                                John K.
                                <small class="contacts-list-date float-end">
                                  2023-1-27
                                </small>
                              </span>
                              <span class="contacts-list-msg">
                                我能看看……
                              </span>
                            </div>
                            <!-- /.contacts-list-info -->
                          </a>
                        </li>
                        <!-- 聊天结束 -->

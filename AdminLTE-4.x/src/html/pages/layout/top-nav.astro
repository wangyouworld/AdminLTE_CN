---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | 顶部导航布局"
const path = "../../../dist"
const htmlPath = "..";

// 智能路径解析：根据目录深度计算相对路径
const pathname = Astro.url.pathname;
const pathSegments = pathname.split('/').filter(segment => segment !== '');
const depth = pathSegments.length > 0 ? pathSegments.length - 1 : 0;
const deploymentPath = depth === 0 ? './' : '../'.repeat(depth);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--
    Top-nav 布局：此页面中**没有** `<aside class="app-sidebar">`，因此
    app-wrapper 网格的侧边栏列（`grid-template-columns: auto 1fr`）会自行
    收缩为零宽度——header、main 和 footer 会横跨整个视口。
    主导航位于 app-header 中，采用一个普通的 Bootstrap
    `navbar-expand-lg`（移动端使用 Collapse + toggler）。没有 PushMenu，因此
    `<body>` 上也没有 `sidebar-expand-*` 类。
  -->
  <!--begin::Body-->
  <body class="bg-body-tertiary">
    <!--begin::App Wrapper-->
    <div class="app-wrapper">
      <!--begin::Header-->
      <nav class="app-header navbar navbar-expand-lg bg-body">
        <!--begin::Container-->
        <div class="container-fluid">
          <!--begin::Brand-->
          <a href={htmlPath + "/index.html"} class="navbar-brand d-flex align-items-center">
            <img
              src={deploymentPath + "assets/img/AdminLTELogo.png"}
              alt="AdminLTE Logo"
              width="30"
              height="30"
              class="opacity-75 shadow me-2"
            />
            <span class="fw-light">AdminLTE 4</span>
          </a>
          <!--end::Brand-->
          <!--begin::Toggler (plain Bootstrap collapse, not PushMenu)-->
          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#topNavMenu"
            aria-controls="topNavMenu"
            aria-expanded="false"
            aria-label="切换导航"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          <!--end::Toggler-->
          <!--begin::Collapsible Menu-->
          <div class="collapse navbar-collapse" id="topNavMenu">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="#">首页</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href={htmlPath + "/starter.html"}>免费</a>
              </li>
              <li class="nav-item dropdown">
                <a
                  class="nav-link dropdown-toggle"
                  href="#"
                  role="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                >页面</a>
                <ul class="dropdown-menu">
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/pages/profile.html"}>资料</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/pages/invoice.html"}>发票</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/pages/calendar.html"}>日历</a>
                  </li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/pages/faq.html"}>FAQ</a>
                  </li>
                </ul>
              </li>
              <li class="nav-item dropdown">
                <a
                  class="nav-link dropdown-toggle"
                  href="#"
                  role="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                >表单</a>
                <ul class="dropdown-menu">
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/forms/elements.html"}>表单</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/forms/advanced.html"}>高级元素</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/forms/editors.html"}>编辑器</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/forms/validation.html"}>验证</a>
                  </li>
                </ul>
              </li>
            </ul>
            <ul class="navbar-nav ms-auto">
              <li class="nav-item">
                <a class="nav-link" href={htmlPath + "/docs/introduction.html"}>
                  <i class="bi bi-book me-1" aria-hidden="true"></i>
                  文档
                </a>
              </li>
            </ul>
          </div>
          <!--end::Collapsible Menu-->
        </div>
        <!--end::Container-->
      </nav>
      <!--end::Header-->
      <!--begin::App Main-->
      <main class="app-main">
        <!--begin::App Content Header-->
        <div class="app-content-header">
          <!--begin::Container-->
          <div class="container-fluid">
            <!--begin::Row-->
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">顶部导航布局</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">首页</a></li>
                    <li class="breadcrumb-item"><a href="#">布局</a></li>
                    <li class="breadcrumb-item active" aria-current="page">顶部导航</li>
                  </ol>
                </nav>
              </div>
            </div>
            <!--end::Row-->
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content Header-->
        <!--begin::App Content-->
        <div class="app-content">
          <!--begin::Container-->
          <div class="container-fluid">
            <div class="row g-4">
              <div class="col-12">
                <div class="callout callout-info">
                  一种适用于只有少量顶级板块的应用的水平布局：
                  侧边栏消失，主导航移入 header 中。
                  将窗口调整到 `<code>lg</code>` 断点以下，即可看到
                  菜单折叠到 toggler 按钮之后。
                </div>
              </div>

              <div class="col-md-6">
                <div class="card card-primary card-outline mb-4">
                  <div class="card-header">
                    <div class="card-title">布局工作原理</div>
                  </div>
                  <div class="card-body">
                    <p>
                      与默认演示页面有三处小差异 &mdash; 无需
                      额外的 CSS 或布局类：
                    </p>
                    <ul class="mb-0">
                      <li class="mb-2">
                        省略了 `<code>&lt;aside class="app-sidebar"&gt;</code>` 元素。
                        <code>app-wrapper</code> 网格用 <code>auto</code> 来
                        设置其侧边栏列的尺寸，因此空列会收缩为
                        零宽度，内容横跨整个视口。
                      </li>
                      <li class="mb-2">
                        header 保留 `<code>app-header</code>` 类，但变成一个
                        普通的 Bootstrap `<code>navbar-expand-lg</code>`，带有
                        toggler 按钮和一个 `<code>.navbar-collapse</code>` 菜单 &mdash;
                        完全不使用 AdminLTE 的 PushMenu。
                      </li>
                      <li>
                        <code>sidebar-expand-*</code> 类从
                        <code>&lt;body&gt;</code> 中移除，因为没有侧边栏需要展开。
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="card card-success card-outline mb-4">
                  <div class="card-header">
                    <div class="card-title">其他一切保持不变</div>
                  </div>
                  <div class="card-body">
                    <p>
                      卡片、内容页头、面包屑、页脚，以及
                      浅色/深色模式，其行为都与
                      侧边栏页面完全一致 &mdash; 这张卡片是未经修改的 AdminLTE 标记。
                    </p>
                    <p class="mb-2">生成月度报告</p>
                    <div
                      class="progress mb-3"
                      role="progressbar"
                      aria-label="生成月度报告"
                      aria-valuenow="72"
                      aria-valuemin="0"
                      aria-valuemax="100"
                    >
                      <div class="progress-bar" style="width: 72%">72%</div>
                    </div>
                    <p class="mb-2">已用</p>
                    <div
                      class="progress mb-3"
                      role="progressbar"
                      aria-label="已用"
                      aria-valuenow="45"
                      aria-valuemin="0"
                      aria-valuemax="100"
                    >
                      <div class="progress-bar text-bg-success" style="width: 45%">45%</div>
                    </div>
                    <a href={htmlPath + "/index.html"} class="btn btn-primary">
                      返回侧边栏布局
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content-->
      </main>
      <!--end::App Main-->
      <Footer />
    </div>
    <!--end::App Wrapper-->
    <!--begin::Script-->
    <Scripts path={path} />
    <!--end::Script-->
  </body><!--end::Body-->
</html>

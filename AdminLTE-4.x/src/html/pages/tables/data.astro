---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | 数据表格"
const path = "../../../dist"
const mainPage = "tables"
const page = "data";

// 智能路径解析：根据目录深度计算相对路径
const pathname = Astro.url.pathname;
const pathSegments = pathname.split('/').filter(segment => segment !== '');
const depth = pathSegments.length > 0 ? pathSegments.length - 1 : 0;
const deploymentPath = depth === 0 ? './' : '../'.repeat(depth);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head title={title} path={path} />
    <link
      rel="stylesheet"
      href={deploymentPath + "assets/tabulator-tables/tabulator_bootstrap5.min.css"}
      crossorigin="anonymous"
    />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">数据表格</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">首页</a></li>
                    <li class="breadcrumb-item"><a href="#">表格</a></li>
                    <li class="breadcrumb-item active" aria-current="page">数据表格</li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">用户</h3>
                <div class="card-tools">
                  <div class="input-group input-group-sm" style="width: 16rem;">
                    <span class="input-group-text">
                      <i class="bi bi-search" aria-hidden="true"></i>
                    </span>
                    <input
                      id="table-filter"
                      type="search"
                      class="form-control"
                      placeholder="筛选行&hellip;"
                      aria-label="Filter rows"
                    />
                  </div>
                </div>
              </div>
              <div class="card-body">
                <div class="d-flex gap-2 mb-3">
                  <button
                    id="export-csv"
                    type="button"
                    class="btn btn-sm btn-outline-secondary"
                  >
                    <i class="bi bi-filetype-csv me-1" aria-hidden="true"></i>
                    导出 CSV
                  </button>
                  <button
                    id="export-json"
                    type="button"
                    class="btn btn-sm btn-outline-secondary"
                  >
                    <i class="bi bi-filetype-json me-1" aria-hidden="true"></i>
                    导出 JSON
                  </button>
                  <button
                    id="print-table"
                    type="button"
                    class="btn btn-sm btn-outline-secondary"
                  >
                    <i class="bi bi-printer me-1" aria-hidden="true"></i>
                    打印
                  </button>
                </div>
                <div id="users-table"></div>
              </div>
              <div class="card-footer text-secondary small">
                由
                <a
                  href="https://tabulator.info/"
                  target="_blank"
                  rel="noopener"
                >Tabulator</a>
                &mdash; 提供支持 — 基于纯 JS，无需 jQuery。
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
    <script
      src={deploymentPath + "assets/tabulator-tables/tabulator.min.js"}
      crossorigin="anonymous"></script>
    <script is:inline>
      const statusBadge = (cell) => {
        const value = cell.getValue();
        const map = { Active: "success", Invited: "info", Suspended: "secondary" };
        const color = map[value] || "secondary";
        return `<span class="badge text-bg-${color}">${value}</span>`;
      };

      document.addEventListener("DOMContentLoaded", () => {
        const data = [
          { id: 1, name: "奥利维亚·贝内特", email: "olivia@example.com", role: "管理员", status: "活跃", joined: "2024-03-12" },
          { id: 2, name: "利亚姆·卡特", email: "liam@example.com", role: "编辑", status: "活跃", joined: "2024-04-08" },
          { id: 3, name: "艾玛·达斯温", email: "emma@example.com", role: "访客", status: "已邀请", joined: "2024-06-21" },
          { id: 4, name: "诺亚·埃文斯", email: "noah@example.com", role: "编辑", status: "已暂停", joined: "2024-07-15" },
          { id: 5, name: "艾娃·福斯特", email: "ava@example.com", role: "管理员", status: "活跃", joined: "2024-08-30" },
          { id: 6, name: "伊桑·格兰特", email: "ethan@example.com", role: "访客", status: "活跃", joined: "2024-09-14" },
          { id: 7, name: "索菲亚·海耶斯", email: "sophia@example.com", role: "编辑", status: "活跃", joined: "2024-10-02" },
          { id: 8, name: "梅森·英格拉姆", email: "mason@example.com", role: "访客", status: "已邀请", joined: "2024-11-19" },
          { id: 9, name: "伊莎贝拉·琼斯", email: "isabella@example.com", role: "管理员", status: "活跃", joined: "2025-01-05" },
          { id: 10, name: "卢卡斯·克莱因", email: "lucas@example.com", role: "访客", status: "已暂停", joined: "2025-02-18" },
          { id: 11, name: "米娅·洛佩斯", email: "mia@example.com", role: "编辑", status: "活跃", joined: "2025-03-22" },
          { id: 12, name: "洛根·摩尔", email: "logan@example.com", role: "访客", status: "活跃", joined: "2025-04-09" },
          { id: 13, name: "夏洛特·尼尔森", email: "charlotte@example.com", role: "管理员", status: "活跃", joined: "2025-04-27" },
          { id: 14, name: "亨利·欧文斯", email: "henry@example.com", role: "编辑", status: "已邀请", joined: "2025-05-11" },
          { id: 15, name: "阿米莉亚·普莱斯", email: "amelia@example.com", role: "访客", status: "活跃", joined: "2025-05-17" }
        ];

        const table = new Tabulator("#users-table", {locale: "zh-cn",langs: {"zh-cn":{"pagination":{"page_size":"每页显示","page_title":"第 {page} 页","first":"首页","first_title":"第一页","last":"末页","last_title":"最后一页","prev":"上一页","prev_title":"上一页","next":"下一页","next_title":"下一页","all":"全部"},"headerFilters":{"default":"筛选..."}}},locale: "zh-cn",langs: {"zh-cn":{"pagination":{"page_size":"每页显示","page_title":"第 {page} 页","first":"首页","first_title":"第一页","last":"末页","last_title":"最后一页","prev":"上一页","prev_title":"上一页","next":"下一页","next_title":"下一页","all":"全部"},"headerFilters":{"default":"筛选..."}}},
          data: data,
          layout: "fitColumns",
          pagination: true,
          paginationSize: 10,
          paginationSizeSelector: [10, 25, 50, 100],
          movableColumns: true,
          columns: [
            { title: "#", field: "id", width: 60, headerSort: true },
            { title: "名字", field: "name", headerFilter: "input" },
            { title: "邮箱", field: "email", headerFilter: "input" },
            {
              title: "规则",
              field: "role",
              headerFilter: "list",
              headerFilterParams: { values: ["", "管理员", "编辑", "访客"] },
              width: 120
            },
            {
              title: "状态",
              field: "status",
              formatter: statusBadge,
              headerFilter: "list",
              headerFilterParams: { values: ["", "活跃", "已邀请", "已暂停"] },
              width: 130,
              hozAlign: "center"
            },
            { title: "加入", field: "joined", sorter: (a, b) => {return new Date(a) - new Date(b);}, width: 130 }
          ]
        });

        document.getElementById("table-filter").addEventListener("input", (e) => {
          const value = e.target.value;
          if (value) {
            table.setFilter([
              [
                { field: "name", type: "like", value: value },
                { field: "email", type: "like", value: value }
              ]
            ]);
          } else {
            table.clearFilter();
          }
        });

        document
          .getElementById("export-csv")
          .addEventListener("click", () => table.download("csv", "users.csv"));
        document
          .getElementById("export-json")
          .addEventListener("click", () => table.download("json", "users.json"));
        document
          .getElementById("print-table")
          .addEventListener("click", () => table.print(false, true));
      });
    </script>
  </body>
</html>
